{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "ogImage": {
      "type": "string"
    },
    "cover": {
      "type": "string"
    },
    "locale": {
      "default": "en",
      "type": "string",
      "enum": [
        "en",
        "fr"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "tagline",
    "category",
    "date",
    "slug"
  ]
}
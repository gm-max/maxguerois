---
/**
 * /fr/peptides — landing dédiée au trafic Instagram peptides.
 *
 * Plan : docs/designs/2026-08-26-fr-peptides-landing.md
 * Maquette : ~/.gstack/projects/gm-max-maxguerois/designs/
 *            fr-newsletter-personne-dabord-20260826/sketch-v7-mobile.html
 *
 * Trois choses que cette page fait différemment du reste du site, chacune pour
 * une raison écrite dans le plan :
 *
 * 1. `emailModal={false}` — la modale beehiiv du site entier est supprimée ici,
 *    la page a la sienne, qui offre le guide et poste chez nous (D5, D19, D25).
 * 2. Pas de `hideFooter` — donc le vrai footer de Layout se rend. `HeroFooter`
 *    est un dock `position: fixed` qui s'efface au scroll, il n'a rien à faire
 *    sur une page qui scrolle sur six blocs (D30).
 * 3. La photo sort de `.container`, sinon elle hérite de 24px de gouttière et
 *    cesse d'être un bandeau (audit padding du 26/08).
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

/**
 * Rendered on demand, not prerendered.
 *
 * This is the SECOND on-demand route on a site whose plan said there would be one,
 * and it was a deliberate call (D52). The reason: the form is a real `<form>`, so it
 * works without JavaScript — the server stores the email and redirects back here
 * with `?ok=1`. But the only code that turned `?ok=1` into a visible confirmation
 * lived in JavaScript, so a visitor without it signed up for real and landed on a
 * page identical to the one they left. They concluded it had failed and submitted
 * again. `?error=` had no rendering at all, JavaScript or not.
 *
 * The cost is a server round-trip on the funnel's most-visited page. The
 * Cache-Control below buys most of it back: Vercel keys its edge cache on the full
 * URL, so the bare page and each `?ok=1` variant are cached separately and neither
 * is personalised.
 */
export const prerender = false;

Astro.response.headers.set(
    'Cache-Control',
    'public, max-age=0, s-maxage=300, stale-while-revalidate=86400',
);

const locale = 'fr';

// Same codes as /api/subscribe. Duplicated on purpose rather than shared: the route
// is server-only and this page must render without importing it.
const ERROR_MESSAGES: Record<string, string> = {
    invalid_email: "Cet email n'a pas l'air valide.",
    _: "Ça n'a pas marché de notre côté. Réessayez, ou écrivez-moi à hi@maxguerois.com.",
};
const params = Astro.url.searchParams;
const submitted = params.get('ok') === '1';
const submitErrorCode = params.get('error');
const submitError = submitErrorCode
    ? (ERROR_MESSAGES[submitErrorCode] ?? ERROR_MESSAGES._)
    : null;
const DONE_TEXT = "Le guide arrive, pensez aux spams.";

// Les 3 articles montrés en preuve d'écriture. Choisis, pas triés par date :
// ce sont les seuls dont l'angle sert un lecteur venu pour les peptides.
const SHOWN = ['retatrutide', 'supplements', 'max-biomarkers'] as const;

// L'utilité pour le lecteur, pas le résumé de l'article. Un titre seul ne dit
// pas en quoi l'article aide, c'était la trouvaille du 26/08.
const USEFULNESS: Record<string, string> = {
    retatrutide: "Les effets réels d'un peptide de perte de poids, mesurés sur moi.",
    supplements: 'À quoi sert chacun, un par un.',
    'max-biomarkers': "Quels tests santé je fais, chez qui, et ce qu'ils m'ont appris.",
};

const all = await getCollection('experiments');
const articles = SHOWN.map((slug) => all.find((e) => e.data.locale === 'fr' && e.data.slug === slug))
    .filter((e): e is NonNullable<typeof e> => Boolean(e));

const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const HERO = '/health-journey/max-peptides-hero.jpg';
---
<Layout
    title="Newsletter peptides — Max Guerois"
    description="Chaque lundi : ce qui est prouvé sur les peptides, ce qui ne l'est pas, et ce que le marché raconte à côté. Par Max Guerois, entrepreneur, qui teste sur sa propre santé."
    ogUrl="https://maxguerois.com/fr/peptides"
    ogImage={`https://maxguerois.com${HERO}`}
    ogImageAlt="Max Guerois"
    locale={locale}
    emailModal={false}
>

<style>
    /* ── Échelle typo : six pas, deux familles, tous dans DESIGN.md ──
       Aucune taille en dur ailleurs dans cette feuille. */
    .pep {
        --t-h1: 38px;
        --t-h2: 24px;
        --t-item: 16px;
        --t-body: 16px;   /* jamais < 16px : Safari iOS zoome sur tout input en dessous */
        --t-cal: 14px;
        --t-micro: 13px;
        --t-label: 12px;
        /* Hauteur de la navbar, recopiee de nav.css:12. La navbar est
           position:fixed et body n'a aucun padding-top, donc une image collee
           a y=0 passe sous la barre. Ici elle y perdait la tete du sujet. */
        --pep-nav-h: 56px;
    }
    @media (min-width: 601px) { .pep { --t-h1: 52px; } }

    /* ── HÉROS ──
       Mobile : photo en bandeau pleine largeur, texte dessous.
       ≥900px : deux colonnes, texte à gauche, photo verticale à droite.

       Pourquoi une composition et pas un simple plafond de hauteur : la photo
       est pleine largeur, donc sa hauteur suit la LARGEUR du viewport. Mesuré
       sur 1280x820 avant correction : image 720px, soit 88% du premier écran,
       et le bouton à y=1091, donc 271px SOUS la ligne de flottaison. Plus
       l'écran est large, pire c'est. Des colonnes bornent le problème au lieu
       de le repousser. */
    .pep-hero { margin-top: var(--pep-nav-h); }
    .pep-hero-body { padding: var(--sp-6) var(--sp-6) 0; }
    @media (min-width: 1280px) {
        /* La grille n'est PAS centree, elle est ancree sur le bord gauche de
           `.container`. Centrer une grille large et centrer une colonne de
           620px ne peuvent pas partager un bord gauche : mesure avant
           correction, 230px de derive entre le texte du heros et le label de
           la premiere section. Deux systemes d'alignement sur une meme page se
           voient immediatement.
           Ici la colonne de texte fait exactement --content-width et demarre au
           meme x que tout le reste ; l'image occupe ce qui reste et file
           jusqu'au bord droit. */
        .pep-hero {
            display: grid;
            /* `.container` est en border-box : sa boite fait --content-width
               mais son CONTENU commence 24px plus a droite. La colonne de texte
               reprend donc la largeur de contenu, pas la largeur de boite, et
               le padding gauche ajoute les memes 24px. Sans ce detail il reste
               24px de derive, mesurables. */
            grid-template-columns: calc(var(--content-width) - var(--sp-6) * 2) 1fr;
            gap: var(--sp-12);
            /* `stretch`, pas `center`. Avec `center`, l'image imposait sa propre
               hauteur via son aspect-ratio et debordait du bloc texte des deux
               cotes : mesure a 1440x900, texte 322px, image 483px, donc 80px de
               debordement en haut ET en bas. La photo flottait au lieu de faire
               bloc avec le texte, et laissait un vide mort a gauche sous la
               micro-ligne. */
            align-items: stretch;
            /* Plancher sur la RANGEE, pas sur le conteneur. Pose sur
               `.pep-hero`, les 48px de padding haut le mangeaient et la rangee
               ne gagnait que 10px : mesure, 332px au lieu des 380 demandes.
               Le bloc texte seul fait ~322px ; sans ce plancher la photo
               tombait a sa hauteur et perdait toute presence. */
            grid-template-rows: minmax(420px, auto);
            padding: var(--sp-12) 0 0
                calc((100% - var(--content-width)) / 2 + var(--sp-6));
        }
        .pep-hero-body { order: 1; padding: 0; }
        /* Selecteur descendant volontaire : la regle de base .pep-hero-img est
           declaree PLUS BAS dans cette feuille, donc a specificite egale elle
           gagnerait et le ratio resterait 3/2. Mesure : image 400x267 au lieu
           de 400x500. */
        .pep-hero .pep-hero-img {
            order: 2;
            /* La hauteur vient de la RANGEE, plus de l'image. C'est ce qui
               supprime le debordement de 80px mesure en haut et en bas. */
            aspect-ratio: auto;
            height: 100%;
            width: 100%;
            min-height: 0;
            object-position: 42% 22%;
            /* Plafond de LARGEUR, collee au bord droit. Sans lui, sur un 1920
               la colonne restante fait 626px et la photo devient un
               panoramique. `justify-self: end` la garde au bord de l'ecran,
               donc le vide eventuel tombe ENTRE le texte et elle, jamais
               apres elle. */
            max-width: 520px;
            justify-self: end;
            border-radius: var(--radius-sm) 0 0 var(--radius-sm);
        }
    }

    /* aspect-ratio + width/height sur la balise : la place est réservée avant
       le chargement, donc aucun décalage de mise en page. */
    .pep-hero-img {
        display: block;
        width: 100%;
        /* `height: auto` n'est PAS decoratif. L'attribut height="733" de la
           balise est une hauteur presentationnelle : avec width:100% la boite
           avait deux dimensions definies, donc aspect-ratio etait ignore et
           l'image se rendait en 375x733 au lieu de 375x250. Resultat mesure :
           le formulaire tombait a y=1099 sur un viewport de 812, donc sous la
           ligne de flottaison, ce qui est exactement ce que la page ne doit
           pas faire. Les attributs restent pour reserver la place au
           chargement. */
        height: auto;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        object-position: 38% 40%;
        background: var(--bg-subtle);
    }
    /* Entre 601 et 1279px, la photo reste un bandeau. La composition en deux
       colonnes n'a la place de respirer qu'au-dela : la colonne image vaut
       largeur/2 - 334, soit 166px sur un ecran de 1000. Un ruban vertical.
       Le plafond de hauteur n'est pas cosmetique : en 1000x800 sans lui,
       l'image faisait 667px et le bouton tombait a y=981, sous le pli. */
    @media (min-width: 601px) and (max-width: 1279px) {
        /* Le plafond recadre fort dans la hauteur : sur un 3/2 ramene a 2.9/1,
           327px de source disparaissent. A 40% en Y, le haut du crane etait
           coupe. 10% garde le visage entier. */
        .pep-hero-img {
            aspect-ratio: 2 / 1;
            max-height: 340px;
            object-position: 38% 10%;
        }
        /* Le texte du heros doit rester sur le meme axe que les sections en
           dessous. Sans ca, entre 601 et 1279px il commencait a 24px du bord
           pendant que `.container` centrait sa colonne de 620px : 190px de
           derive mesures sur un ecran de 1000. */
        .pep-hero-body {
            max-width: var(--content-width);
            margin: 0 auto;
        }
    }

    .pep { font-size: var(--t-body); }

    .pep-eyebrow {
        font-family: var(--font-body);
        font-size: var(--t-label);
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin: 0 0 var(--sp-3);
    }
    .pep-eyebrow b { color: var(--accent); font-weight: 500; }

    .pep h1 {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: var(--t-h1);
        line-height: 1.08;
        letter-spacing: -0.01em;
        margin: 0 0 var(--sp-3);
        color: var(--text);
    }
    .pep h1 em { font-style: italic; color: var(--accent); }

    .pep-sub {
        font-size: var(--t-body);
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
        max-width: 34em;
    }

    .pep-section { margin-top: var(--sp-16); }
    @media (min-width: 601px) { .pep-section { margin-top: var(--sp-20); } }

    .pep-label {
        font-family: var(--font-body);
        font-size: var(--t-label);
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin: 0 0 var(--sp-3);
    }
    .pep h2 {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: var(--t-h2);
        line-height: 1.2;
        margin: 0 0 var(--sp-4);
        color: var(--text);
    }
    .pep-text {
        font-size: var(--t-body);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 0 var(--sp-4);
    }

    /* ── Lignes : preuves ET articles partagent UN composant (Writing Item,
       DESIGN.md), sans l'encapsulation en carte. ── */
    .pep-rows { border-top: 1px solid var(--border); }
    .pep-row {
        display: block;
        padding: var(--sp-4) 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
    }
    a.pep-row { padding: var(--sp-6) 0; }
    a.pep-row:hover .pep-row-t { color: var(--accent); }
    .pep-row-t {
        display: block;
        font-family: var(--font-display);
        font-weight: 500;
        font-size: var(--t-item);
        line-height: 1.4;
        color: var(--text);
        transition: color var(--duration-short) var(--ease-out);
    }
    .pep-row-d {
        display: block;
        font-size: var(--t-micro);
        color: var(--text-secondary);
        line-height: 1.6;
        margin-top: 2px;
    }
    .pep-row-d a {
        color: var(--text-secondary);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--accent-mid);
    }
    a.pep-row .pep-row-d { margin-top: var(--sp-2); margin-bottom: var(--sp-3); }
    .pep-row-meta {
        display: block;
        font-size: var(--t-micro);
        color: var(--text-tertiary);
    }

    /* ── Callout Box, spec DESIGN.md : bordure, radius-lg, pas de remplissage,
       label 12 tertiaire, corps 14 secondaire. ── */
    .pep-callout {
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: var(--sp-4) var(--sp-6);
        margin-top: var(--sp-6);
    }
    .pep-callout .pep-label { margin-bottom: var(--sp-2); }
    .pep-callout p {
        margin: 0;
        font-size: var(--t-cal);
        line-height: 1.6;
        color: var(--text-secondary);
    }

    /* ── Mission : une idée par ligne, 48px entre chacune. ── */
    .pep-mission p {
        margin: 0 0 var(--sp-12);
        font-size: var(--t-body);
        line-height: 1.55;
        color: var(--text);
    }
    .pep-mission p:last-child { margin-bottom: 0; }
    .pep-mission .dim { color: var(--text-secondary); }
    /* Text Highlight — composant DESIGN.md, réutilise --accent-light. */
    .mark {
        background: var(--accent-light);
        box-shadow: 0 0 0 3px var(--accent-light);
        border-radius: 2px;
    }

    /* ── Liste 1-2-3 ── */
    .pep-what { list-style: none; counter-reset: w; margin: var(--sp-6) 0 0; padding: 0; }
    .pep-what li {
        counter-increment: w;
        position: relative;
        padding: 0 0 var(--sp-6) var(--sp-8);
        font-size: var(--t-body);
        color: var(--text-secondary);
        line-height: 1.6;
    }
    .pep-what li::before {
        content: counter(w);
        position: absolute;
        left: 0;
        top: -1px;
        font-family: var(--font-display);
        font-size: var(--t-h2);
        font-weight: 300;
        color: var(--accent);
    }
    .pep-what b { font-weight: 500; color: var(--text); }

    .pep-close { border-top: 1px solid var(--border); padding-top: var(--sp-12); }
    /* Le formulaire du pic d'intention, isolé de la liste 1-2-3. Sans ce filet
       les deux blocs se collent et la section a l'air de se répéter. */
    .pep-inline { margin-top: var(--sp-12); padding-top: var(--sp-8); border-top: 1px solid var(--border); }

    /* ── Formulaire ── */
    .pf-label {
        display: block;
        font-family: var(--font-body);
        font-size: var(--t-label);
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin: 0 0 var(--sp-2);
    }
    .pf-row { display: flex; flex-direction: column; gap: var(--sp-2); }
    @media (min-width: 601px) {
        .pf-row { flex-direction: row; max-width: 480px; }
        .pf-row input { flex: 1; min-width: 0; }
    }
    .pf-row input {
        width: 100%;
        height: 48px;
        padding: 0 var(--sp-4);
        font-family: var(--font-body);
        font-size: var(--t-body);
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        transition: border-color var(--duration-short) var(--ease-out);
    }
    .pf-row input::placeholder { color: var(--text-tertiary); }
    .pf-row input[aria-invalid='true'] { border-color: var(--accent); }
    .pf-row button {
        height: 48px;
        padding: 0 22px;
        font-family: var(--font-body);
        font-size: var(--t-body);
        font-weight: 500;
        /* #1a1a1a, jamais #fff : blanc sur l'ambre = 2,76:1, échoue WCAG AA
           (DESIGN.md, 2026-08-26). */
        color: #1a1a1a;
        background: var(--accent);
        border: 0;
        border-radius: var(--radius-full);
        cursor: pointer;
        white-space: nowrap;
        transition: opacity var(--duration-short) var(--ease-out);
    }
    @media (max-width: 600px) { .pf-row button { width: 100%; } }
    .pf-row button[disabled] { opacity: 0.6; cursor: default; }
    .pf-err {
        margin: var(--sp-2) 0 0;
        font-size: var(--t-micro);
        color: var(--accent);
        line-height: 1.5;
    }
    .pf-micro {
        margin: var(--sp-3) 0 0;
        font-size: var(--t-micro);
        color: var(--text-tertiary);
        line-height: 1.5;
    }
    /* Honeypot. Jamais display:none — certains lecteurs d'écran et surtout
       certains bots traitent display:none comme « à ignorer », or on veut que
       le bot le voie et le remplisse. */
    .pf-hp {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        opacity: 0;
    }
    .pf-done {
        margin: 0;
        font-size: var(--t-body);
        line-height: 1.6;
        color: var(--text);
    }
    .pf-done b { font-weight: 500; }

    /* ── Pop-up guide ──
       Le <dialog> EST la carte. Le voile est ::backdrop, que le navigateur
       dimensionne au viewport entier, gratuitement.

       Ce que faisait la version precedente, et pourquoi elle etait cassee en
       production, mesure sur maxguerois.com en 1280x820 :

       1. `.pg[open] { display: block }` etait ecrit AVANT `.pg { display: flex }`.
          `[open]` a une specificite plus forte, donc `block` gagnait et le
          centrage n'a jamais rien fait : carte collee a top:28px.
       2. Le voile etait peint sur le <dialog> lui-meme, avec `::backdrop` mis a
          `transparent`. Or `inset: 0` n'etire une dimension que si elle vaut
          `auto` : `width` etait fixe, `height` restait auto, donc le voile
          s'arretait a la hauteur du contenu. Mesure : 302px sur 820.
       3. Consequence : 518px de page qui paraissaient normaux, couverts par le
          ::backdrop invisible du navigateur, donc inertes. On clique, rien ne
          repond, ni la modale ni la page. Indiscernable de "je ne peux pas la
          fermer".

       Le centrage se fait maintenant par `inset: 0` + `margin: auto`, qui ne
       depend d'aucun display et marche donc quoi que fasse l'UA. */
    .pg {
        position: fixed;
        inset: 0;
        margin: auto;
        width: min(420px, calc(100% - var(--sp-8)));
        max-width: none;
        height: fit-content;
        max-height: calc(100dvh - var(--sp-8));
        padding: 0;
        border: 0;
        background: transparent;
        overflow: visible;
    }
    .pg::backdrop { background: rgba(26, 26, 26, 0.45); }
    /* En sombre, le fond du site est #0f0e0c, plus sombre que le rgb(26,26,26)
       du voile : celui-ci ECLAIRCISSAIT la page au lieu de l'assombrir. Le
       :global() est necessaire, l'attribut data-theme vit sur <html>, hors de
       la portee du style scope de ce composant. */
    :global([data-theme='dark']) .pg::backdrop { background: rgba(0, 0, 0, 0.62); }
    .pg-card {
        position: relative;
        max-height: calc(100dvh - var(--sp-8));
        overflow-y: auto;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: var(--sp-6);
        animation: pg-rise var(--duration-base) var(--ease-out);
    }
    /* Dans une carte de 420px, la rangee en ligne laissait 71px a l'input parce
       que le bouton est en `nowrap` et prenait 291px. Mesure en production. */
    .pg .pf-row { flex-direction: column; max-width: none; }
    .pg .pf-row button { width: 100%; }
    @keyframes pg-rise { from { opacity: 0; transform: translateY(12px); } }
    .pg-close {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--t-h2);
        line-height: 1;
        color: var(--text-tertiary);
        background: none;
        border: 0;
        cursor: pointer;
    }
    .pg-close:hover { color: var(--text); }
    .pg-card h2 { margin-bottom: var(--sp-3); padding-right: var(--sp-8); }

    @media (prefers-reduced-motion: reduce) {
        .pg-card { animation: none; }
        .pep-row-t, .pf-row input, .pf-row button { transition: none; }
    }
</style>

<div class="pep">

    <!-- 1 · HÉROS. L'image est HORS .container, sinon elle hérite de 24px de
         gouttière et devient une vignette au lieu d'un bandeau. -->
    <section class="pep-hero">
        <img
            class="pep-hero-img"
            src={HERO}
            alt="Max Guerois, en conversation"
            width="1100"
            height="733"
            fetchpriority="high"
            decoding="async"
        />
        <div class="pep-hero-body">
            <p class="pep-eyebrow">Max Guerois · <b>Newsletter peptides</b></p>
            <h1>On explore les peptides <em>ensemble</em>.</h1>
            <p class="pep-sub">Ce qui est prouvé, ce qui ne l'est pas, et ce que le marché raconte à côté.</p>

            <div class="pep-inline" style="margin-top: var(--sp-8); padding-top: 0; border-top: 0;">
                {submitted ? (
                    <p class="pf-done" role="status" tabindex="-1">
                        <b>C'est fait.</b> {DONE_TEXT}
                    </p>
                ) : (
                <form class="pf" data-subscribe method="POST" action="/api/subscribe?lang=fr-peptides">

    </div>

    <!-- POP-UP GUIDE. Sans image : la modale doit s'ouvrir instantanément. -->
    <dialog class="pg" id="pep-guide" aria-labelledby="pg-title">
        <div class="pg-card">
            <button class="pg-close" type="button" data-pg-close aria-label="Fermer">&times;</button>
            <h2 id="pg-title">Le guide des peptides, offert.</h2>
            <p class="pep-text" style="font-size: var(--t-cal); margin-bottom: var(--sp-6);">
                12 peptides passés en revue. 6 signaux qui trahissent un vendeur douteux.
            </p>
            <form class="pf" data-subscribe method="POST" action="/api/subscribe?lang=fr-peptides">
                <label class="pf-label" for="pf-modal">Votre email</label>
                <input type="hidden" name="source" value="fr-peptides-modal" />
                <input type="hidden" name="utm_source" value="instagram" />
                <input class="pf-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <div class="pf-row">
                    <input
                        id="pf-modal"
                        name="email"
                        type="email"
                        required
                        inputmode="email"
                        autocomplete="email"
                        autocapitalize="off"
                        spellcheck="false"
                        placeholder="votre@email.com"
                        aria-describedby="pf-modal-err"
                    />
                    <button type="submit">S'inscrire à la newsletter du lundi</button>
                </div>
                <p class="pf-err" role="alert" id="pf-modal-err" hidden></p>
                <p class="pf-micro">Gratuit. Désinscription en un clic.</p>
            </form>
        </div>
    </dialog>
</div>

<script is:inline>
    (function () {
        // Une seule definition du message de succes. Il etait ecrit en dur a deux
        // endroits plus bas, avec cette constante declaree et jamais lue : trois
        // copies d'une phrase, dont deux qui derivent au premier changement.
        var DONE_HTML = "<b>C'est fait.</b> Le guide arrive, pensez aux spams.";
        var ERRORS = {
            invalid_email: "Cet email n'a pas l'air valide.",
            rate_limited: "Ça n'a pas marché de notre côté. Réessayez, ou écrivez-moi à hi@maxguerois.com.",
            store_failed: "Ça n'a pas marché de notre côté. Réessayez, ou écrivez-moi à hi@maxguerois.com.",
            bad_request: "Ça n'a pas marché de notre côté. Réessayez, ou écrivez-moi à hi@maxguerois.com.",
            _: "Ça n'a pas marché de notre côté. Réessayez, ou écrivez-moi à hi@maxguerois.com."
        };

        // La pop-up est planifiee au chargement. Sans ce verrou, quelqu'un qui
        // s'inscrit a t=3s voyait la modale s'ouvrir a t=8s pour lui redemander
        // exactement ce qu'il venait de faire. Trouve par une revue exterieure.
        var KEY = 'mg_peptides_guide_v1';
        var modalTimer = null;
        // DESARME la pop-up, ne la ferme PAS.
        //
        // Elle fermait, et c'etait faux exactement la ou ca comptait : une
        // inscription DEPUIS la modale affichait le message de succes puis
        // refermait la modale dans la foulee. Le visiteur voyait la fenetre
        // disparaitre sans confirmation, et un lecteur d'ecran recevait le focus
        // sur un contenu masque dans la seconde.
        //
        // Fermer n'a d'ailleurs jamais servi ailleurs : quand la modale est
        // ouverte, `showModal()` rend la page inerte, donc aucun formulaire en
        // ligne ne peut etre soumis derriere. Le seul cas ou `close()` se
        // declenchait etait le seul ou il ne fallait pas.
        function disarmModal() {
            if (modalTimer) { clearTimeout(modalTimer); modalTimer = null; }
            try { localStorage.setItem(KEY, '1'); } catch (e0) {}
        }

        // Un SEUL comportement pour les quatre formulaires (3 en ligne + la
        // modale). Quatre copies divergeraient, et la première à diverger
        // serait celle de la modale, qu'on ouvre le moins souvent.
        function bind(form) {
            var input = form.querySelector('input[name="email"]');
            var button = form.querySelector('button[type="submit"]');
            var err = form.querySelector('.pf-err');
            var label = button.textContent;

            function showError(msg) {
                err.textContent = msg;
                err.hidden = false;
                input.setAttribute('aria-invalid', 'true');
            }
            function clearError() {
                err.hidden = true;
                input.removeAttribute('aria-invalid');
            }

            // Validation au blur, jamais à chaque frappe : corriger quelqu'un
            // pendant qu'il tape est le moyen le plus sûr de le faire partir.
            input.addEventListener('blur', function () {
                if (input.value && !input.checkValidity()) showError(ERRORS.invalid_email);
                else clearError();
            });
            input.addEventListener('input', clearError);

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (!input.checkValidity()) { showError(ERRORS.invalid_email); input.focus(); return; }
                clearError();
                button.disabled = true;
                button.textContent = 'Une seconde…';
                form.setAttribute('aria-busy', 'true');

                var payload = {};
                new FormData(form).forEach(function (v, k) { payload[k] = v; });

                fetch(form.getAttribute('action'), {
                    method: 'POST',
                    headers: { 'content-type': 'application/json', accept: 'application/json' },
                    body: JSON.stringify(payload)
                })
                    .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
                    .then(function (res) {
                        if (!res.ok || !res.body.ok) throw new Error(res.body.error || '_');
                        // Succès : le bloc formulaire ENTIER est remplacé, et le
                        // message reçoit le focus. Sans role+focus, un lecteur
                        // d'écran ne saura jamais que l'inscription a marché.
                        var done = document.createElement('p');
                        done.className = 'pf-done';
                        done.setAttribute('role', 'status');
                        done.setAttribute('tabindex', '-1');
                        done.innerHTML = DONE_HTML;
                        form.parentNode.replaceChild(done, form);
                        done.focus();
                        disarmModal();
                    })
                    .catch(function (e2) {
                        // Le champ n'est JAMAIS vidé sur erreur.
                        button.disabled = false;
                        button.textContent = label;
                        form.removeAttribute('aria-busy');
                        showError(ERRORS[e2.message] || ERRORS._);
                    });
            });
        }

        var forms = document.querySelectorAll('form[data-subscribe]');
        for (var i = 0; i < forms.length; i++) bind(forms[i]);

        // Le retour du chemin SANS JavaScript est rendu par le SERVEUR maintenant
        // (D52) : ce bloc dupliquait le travail et, surtout, il ne pouvait rien faire
        // pour quelqu'un qui n'execute pas de JavaScript, ce qui etait tout le
        // probleme. Il reste juste a ne pas ouvrir la pop-up apres une inscription.
        var params = new URLSearchParams(location.search);
        if (params.get('ok') === '1') disarmModal();

        // Pop-up : 8 s, une seule fois par visiteur. La clé est écrite à
        // l'affichage et non à la fermeture, sinon quelqu'un qui recharge avant
        // de fermer la revoit à chaque visite.
        var dlg = document.getElementById('pep-guide');
        if (dlg && !params.get('ok')) {
            var seen = false;
            try { seen = localStorage.getItem(KEY) === '1'; } catch (e3) { seen = true; }
            if (!seen) {
                modalTimer = setTimeout(function () {
                    modalTimer = null;
                    if (!document.body.contains(dlg)) return;
                    try { localStorage.setItem(KEY, '1'); } catch (e4) {}
                    if (typeof dlg.showModal === 'function') dlg.showModal();
                }, 8000);
            }
            dlg.addEventListener('click', function (e5) {
                if (e5.target === dlg) dlg.close();
            });
            var closeBtn = dlg.querySelector('[data-pg-close]');
            if (closeBtn) closeBtn.addEventListener('click', function () { dlg.close(); });
        }
    })();
</script>
</Layout>

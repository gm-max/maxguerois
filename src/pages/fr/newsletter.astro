---
import Layout from '../../layouts/Layout.astro';
import NewsletterEmbed from '../../components/NewsletterEmbed.astro';
import { getCollection } from 'astro:content';

const locale = 'fr';
const allExperiments = await getCollection('experiments');
const archive = allExperiments.filter(e => (e.data as any).locale === 'fr');
archive.sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Layout
    title="The long game of staying young, par Max Guerois"
    description="Je construis ma prochaine boîte au grand jour. Santé et longévité pour l'instant : peptides, tracking, entraînement, compléments. Les expériences que je mène sur moi, la version brute. Deux emails par mois."
    ogUrl="https://maxguerois.com/fr/newsletter"
    ogImage="https://maxguerois.com/health-journey/banner-staying-young.jpg"
    extraStyles={["/styles/article.css"]}
    locale={locale}
>

<style>
    .nl-banner {
        width: 100%;
        display: block;
        border-radius: var(--radius-lg);
        margin: var(--sp-4) 0 var(--sp-8);
    }
    .nl-meta {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: 10px;
    }
    .nl-lead {
        font-size: 17px;
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 540px;
        margin: 0 0 var(--sp-8);
    }
    .nl-section-label {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin: var(--sp-16) 0 var(--sp-2);
    }
    .nl-section-title {
        font-family: var(--font-display);
        font-size: clamp(24px, 3.5vw, 32px);
        font-weight: 400;
        line-height: 1.2;
        color: var(--text);
        margin: 0 0 var(--sp-6);
    }
    .experiments-list { display: flex; flex-direction: column; gap: var(--sp-6); }
    .experiment-item {
        display: block;
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: var(--bg-subtle);
        transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .experiment-item:hover { border-color: var(--accent); transform: translateY(-2px); }
    .experiment-cover {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        background: var(--border);
    }
    .experiment-body { padding: var(--sp-5); }
    .experiment-tag-row { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-3); }
    .experiment-tag {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--text-secondary);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        padding: 3px 10px;
    }
    .experiment-title {
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 400;
        color: var(--text);
        line-height: 1.2;
        margin-bottom: var(--sp-2);
    }
    .experiment-desc {
        font-size: 13px;
        color: var(--text-secondary);
        line-height: 1.5;
        margin-bottom: var(--sp-3);
    }
    .experiment-link {
        font-size: 12px;
        font-weight: 500;
        color: var(--accent);
        text-decoration: none;
        letter-spacing: 0.02em;
    }
</style>

<div class="container">
    <a href="/fr" class="back">&larr; Retour à l'accueil</a>

    <img
        class="nl-banner"
        src="/health-journey/banner-staying-young.jpg"
        alt="The long game of staying young, une newsletter de Max Guerois"
        fetchpriority="high"
    >

    <div class="nl-meta">La newsletter</div>
    <p class="nl-lead">J'ai quitté ma précédente startup santé. Je repars de zéro, et je construis ma prochaine boîte au grand jour.</p>
    <p class="nl-lead">Je partage tout au fur et à mesure, la version brute : les expériences que je mène sur moi, la recherche, ce qui marche et ce qui explose en vol.</p>
    <p class="nl-lead">Pour l'instant c'est surtout santé et longévité : peptides, tracking, entraînement, et compléments.</p>

    <NewsletterEmbed locale={locale} />

    <div class="nl-section-label">L'archive</div>
    <h2 class="nl-section-title">Ce sur quoi je travaille</h2>

    <div class="experiments-list">
        {archive.map((exp, i) => (
            <a href={`/fr/${exp.data.slug}`} class="experiment-item">
                {exp.data.cover && (
                    <img class="experiment-cover" src={exp.data.cover} alt={exp.data.title} loading="lazy" />
                )}
                <div class="experiment-body">
                    <div class="experiment-tag-row">
                        <span class="experiment-tag">{exp.data.category}</span>
                        {i === 0 && <span class="experiment-tag">Récent</span>}
                    </div>
                    <div class="experiment-title">{exp.data.title}</div>
                    <div class="experiment-desc">{exp.data.tagline}</div>
                    <span class="experiment-link">Lire &rarr;</span>
                </div>
            </a>
        ))}
    </div>

    <div style="margin: var(--sp-12) 0 var(--sp-12);">
        <NewsletterEmbed locale={locale} />
    </div>
</div>
</Layout>

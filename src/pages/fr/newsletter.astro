---
import Layout from '../../layouts/Layout.astro';
import NewsletterEmbed from '../../components/NewsletterEmbed.astro';
import HeroFooter from '../../components/HeroFooter.astro';
import { getCollection } from 'astro:content';

const locale = 'fr';
const allExperiments = await getCollection('experiments');
const archive = allExperiments.filter(e => (e.data as any).locale === 'fr');
archive.sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Layout
    title="La newsletter des peptides, par Max Guerois"
    description="Les peptides, expliqués sans jargon. Ce que la littérature permet de dire, ce que les réseaux exagèrent, et ce que mes propres essais permettent ou non de comprendre."
    ogUrl="https://maxguerois.com/fr/newsletter"
    ogImage="https://maxguerois.com/health-journey/banner-staying-young.jpg"
    extraStyles={["/styles/article.css"]}
    locale={locale}
>

<style>
    /* Hero fills the first screen; HeroFooter pins to its bottom (margin-top:auto). */
    .hero {
        min-height: calc(100dvh - var(--sp-20));
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-bottom: var(--sp-16); /* clear the fixed footer bar */
    }
    /* Mobile: flow from the top (the dock drops into normal flow, see HeroFooter). */
    @media (max-width: 600px) {
        .hero {
            min-height: 0;
            justify-content: flex-start;
            padding-top: var(--sp-4);
            padding-bottom: 0;
        }
    }
    /* Minimal inline signup: just the email input + button */
    .nl-form {
        margin-top: var(--sp-2);
        max-width: 480px;
    }
    /* Editorial masthead: type leads, banner demoted to a thumbnail */
    .nl-title {
        font-family: var(--font-display);
        font-size: clamp(40px, 8vw, 60px);
        font-weight: 500;
        line-height: 1.06;
        letter-spacing: -0.01em;
        color: var(--text);
        margin: 6px 0 var(--sp-6);
    }
    .nl-title em {
        display: block;
        font-style: italic;
        color: var(--accent);
    }
    .nl-meta {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: 10px;
    }
    .nl-lead {
        font-size: 17px;
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 540px;
        margin: 0 0 var(--sp-8);
    }
    .nl-section-label {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin: var(--sp-16) 0 var(--sp-2);
    }
    .nl-section-title {
        font-family: var(--font-display);
        font-size: clamp(30px, 5vw, 42px);
        font-weight: 400;
        line-height: 1.15;
        color: var(--text);
        margin: 0 0 var(--sp-6);
    }
    .nl-section-intro {
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.65;
        max-width: 620px;
        margin: 0 0 var(--sp-8);
    }
    .experiments-list { display: flex; flex-direction: column; gap: var(--sp-6); }
    .nl-subscribe { margin-top: var(--sp-16); }
    .experiment-item {
        display: block;
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: var(--bg-subtle);
        transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .experiment-item:hover { border-color: var(--accent); transform: translateY(-2px); }
    .experiment-cover {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        background: var(--border);
    }
    .experiment-body { padding: var(--sp-6); }
    .experiment-tag-row { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-3); }
    .experiment-tag {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--text-secondary);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        padding: 3px 10px;
    }
    .experiment-title {
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 400;
        color: var(--text);
        line-height: 1.2;
        margin-bottom: var(--sp-2);
    }
    .experiment-desc {
        font-size: 13px;
        color: var(--text-secondary);
        line-height: 1.5;
        margin-bottom: var(--sp-3);
    }
    .experiment-link {
        font-size: 12px;
        font-weight: 500;
        color: var(--accent);
        text-decoration: none;
        letter-spacing: 0.02em;
    }
</style>

<div class="container">
    <section class="hero">
        <div class="nl-meta">La newsletter</div>
        <h1 class="nl-title">La newsletter <em>des peptides</em></h1>
        <p class="nl-lead">J'ecris sur les peptides avec une regle simple : partir des faits, puis regarder ce que les reseaux en ont fait.</p>
        <p class="nl-lead">Certaines molecules ont une vraie place. D'autres vivent surtout de temoignages, de raccourcis et de promesses. J'essaie de separer les deux.<br>Rejoignez 1 000+ lecteurs.</p>

        <div class="nl-form">
            <NewsletterEmbed locale={locale} minimal />
        </div>

        <HeroFooter locale={locale} currentPath={Astro.url.pathname} />
    </section>

    <div class="nl-section-label">Archive</div>
    <h2 class="nl-section-title">Les articles</h2>
    <p class="nl-section-intro">Mecanismes, usages, limites, signaux faibles : les articles publies jusqu'ici sur les peptides et les sujets qui gravitent autour.</p>

    <div class="experiments-list">
        {archive
            .map((exp) => (
                <a href={`/fr/newsletter/${exp.data.slug}`} class="experiment-item">
                    {exp.data.cover && (
                        <img class="experiment-cover" src={exp.data.cover} alt={exp.data.title} loading="lazy" />
                    )}
                    <div class="experiment-body">
                        <div class="experiment-tag-row">
                            <span class="experiment-tag">{exp.data.category}</span>
                        </div>
                        <div class="experiment-title">{exp.data.title}</div>
                        <div class="experiment-desc">{exp.data.tagline}</div>
                        <span class="experiment-link">Lire &rarr;</span>
                    </div>
                </a>
            ))}
    </div>

    <div class="nl-subscribe">
        <NewsletterEmbed locale={locale} />
    </div>
</div>
</Layout>

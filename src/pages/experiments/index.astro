---
import Layout from '../../layouts/Layout.astro';
import NewsletterEmbed from '../../components/NewsletterEmbed.astro';
import { getCollection } from 'astro:content';

const experiments = await getCollection('experiments');
// Sort by date descending (newest first)
experiments.sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Layout
    title="Experiments — Max Guerois"
    description="Health experiments, protocols, and biomarker tracking by Max Guerois. Sleep, testosterone, longevity."
    ogUrl="https://maxguerois.com/experiments"
    ogImage="https://maxguerois.com/health-journey/og/bloodwork.jpg"
    extraStyles={["/styles/article.css"]}
>

<style>
    .experiments-header {
        padding: var(--sp-12) 0 var(--sp-8);
    }
    .experiments-meta {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: 10px;
    }
    .experiments-title {
        font-family: var(--font-display);
        font-size: clamp(28px, 4vw, 38px);
        font-weight: 400;
        line-height: 1.2;
        color: var(--text);
        margin: 0 0 var(--sp-4);
    }
    .experiments-intro {
        font-size: 16px;
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 520px;
        margin: 0;
    }
    .experiments-list {
        margin: 40px 0 0;
        border-top: 1px solid var(--border);
    }
    .experiment-item {
        display: block;
        padding: var(--sp-6) 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
    }
    .experiment-item:last-child {
        border-bottom: none;
    }
    .experiment-tag-row {
        display: flex;
        gap: var(--sp-2);
        margin-bottom: var(--sp-3);
    }
    .experiment-tag {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--text-secondary);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        padding: 3px 10px;
    }
    .experiment-title {
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 400;
        color: var(--text);
        line-height: 1.2;
        margin-bottom: var(--sp-2);
    }
    .experiment-desc {
        font-size: 13px;
        color: var(--text-secondary);
        line-height: 1.5;
        margin-bottom: var(--sp-3);
    }
    .experiment-link {
        font-size: 12px;
        font-weight: 500;
        color: var(--accent);
        text-decoration: none;
        letter-spacing: 0.02em;
    }
    .newsletter-section {
        margin: 60px 0 var(--sp-12);
        padding: var(--sp-8);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
    }
    .newsletter-label {
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: var(--sp-2);
    }
    .newsletter-title {
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 400;
        color: var(--text);
        margin-bottom: 6px;
        line-height: 1.3;
    }
    .newsletter-subtitle {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 20px;
        line-height: 1.6;
    }
    .newsletter-block {
        min-height: 80px;
        background: var(--bg-subtle);
    }
</style>

<div class="container">
    <a href="/" class="back">&larr; Back home</a>

    <div class="experiments-header">
        <div class="experiments-meta">Health Experiments</div>
        <h1 class="experiments-title">What I'm tracking and learning</h1>
        <p class="experiments-intro">I run experiments on myself — sleep, hormones, biomarkers — and publish the data. Everything here is honest, sourced, and updated as I learn more.</p>
    </div>

    <div class="experiments-list">
        {experiments.map((exp, i) => (
            <a href={`/${exp.data.slug}`} class="experiment-item">
                <div class="experiment-tag-row">
                    <span class="experiment-tag">{exp.data.category}</span>
                    {i === 0 && <span class="experiment-tag">Latest</span>}
                </div>
                <div class="experiment-title">{exp.data.title}</div>
                <div class="experiment-desc">{exp.data.tagline}</div>
                <span class="experiment-link">Read experiment &rarr;</span>
            </a>
        ))}
    </div>

    <div style="margin: 60px 0 var(--sp-12);">
        <NewsletterEmbed />
    </div>
</div>
</Layout>

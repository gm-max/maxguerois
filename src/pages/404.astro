---
import Layout from '../layouts/Layout.astro';
---
<Layout
    title="Page not found — Max Guerois"
    description="This page doesn't exist or has moved."
    noindex
>
<style>
    .nf-wrap {
        min-height: 56vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: var(--sp-6);
    }
    .nf-code {
        font-family: var(--font-display);
        font-size: clamp(64px, 14vw, 120px);
        font-weight: 500;
        line-height: 1;
        color: var(--accent);
        letter-spacing: -0.02em;
    }
    .nf-title {
        font-family: var(--font-display);
        font-size: clamp(24px, 4vw, 32px);
        font-weight: 400;
        line-height: 1.2;
        color: var(--text);
        margin: 0;
    }
    .nf-lead {
        font-size: 16px;
        color: var(--text-secondary);
        line-height: 1.6;
        max-width: 380px;
        margin: 0;
    }
    .nf-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: var(--sp-3);
        margin-top: var(--sp-2);
    }
    .nf-btn {
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.01em;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: var(--radius-full);
        transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    }
    .nf-btn-primary {
        color: var(--bg);
        background: var(--accent);
        border: 1px solid var(--accent);
    }
    .nf-btn-primary:hover { opacity: 0.88; }
    .nf-btn-ghost {
        color: var(--text-secondary);
        background: transparent;
        border: 1px solid var(--border);
    }
    .nf-btn-ghost:hover { border-color: var(--accent); color: var(--text); }
</style>

<div class="container">
    <div class="nf-wrap">
        <div class="nf-code">404</div>
        <h1 class="nf-title">This page doesn't exist</h1>
        <p class="nf-lead">It may have moved, or the link was wrong. Here's the way back.</p>
        <div class="nf-actions">
            <a href="/" class="nf-btn nf-btn-primary">Back home</a>
            <a href="/newsletter" class="nf-btn nf-btn-ghost">Read the newsletter</a>
        </div>
    </div>
</div>
</Layout>

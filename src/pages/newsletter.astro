---
import Layout from '../layouts/Layout.astro';
import NewsletterEmbed from '../components/NewsletterEmbed.astro';
import HeroFooter from '../components/HeroFooter.astro';
import { getCollection } from 'astro:content';

const allExperiments = await getCollection('experiments');
const archive = allExperiments.filter(e => !e.data.locale || e.data.locale === 'en');
archive.sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Layout
    title="The long game of staying young, by Max Guerois"
    description="Building my next venture in the open. Health and longevity for now: peptides, tracking, training, supplements. The experiments I run on myself, the unfiltered version. Two emails a month."
    ogUrl="https://maxguerois.com/newsletter"
    ogImage="https://maxguerois.com/health-journey/banner-staying-young.jpg"
    extraStyles={["/styles/article.css"]}
    hideFooter
>

<style>
    /* Hero fills the first screen; HeroFooter pins to its bottom (margin-top:auto).
       Flexbox means content can never be overlapped by the footer. */
    .hero {
        min-height: calc(100dvh - var(--sp-20));
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-bottom: var(--sp-16); /* clear the fixed footer bar */
    }
    /* Minimal inline signup: just the email input + button */
    .nl-form {
        margin-top: var(--sp-2);
        max-width: 480px;
    }
    /* Editorial masthead: type leads, banner demoted to a thumbnail */
    .nl-title {
        font-family: var(--font-display);
        font-size: clamp(40px, 8vw, 60px);
        font-weight: 500;
        line-height: 1.06;
        letter-spacing: -0.01em;
        color: var(--text);
        margin: 6px 0 var(--sp-6);
    }
    .nl-title em {
        display: block;
        font-style: italic;
        color: var(--accent);
    }
    .nl-reassure {
        font-family: var(--font-body);
        font-size: 13px;
        color: var(--text-tertiary);
        margin: var(--sp-3) 0 0;
    }
    .nl-meta {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: 10px;
    }
    .nl-lead {
        font-size: 17px;
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 540px;
        margin: 0 0 var(--sp-8);
    }
    .nl-section-label {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin: var(--sp-16) 0 var(--sp-2);
    }
    .nl-section-title {
        font-family: var(--font-display);
        font-size: clamp(24px, 3.5vw, 32px);
        font-weight: 400;
        line-height: 1.2;
        color: var(--text);
        margin: 0 0 var(--sp-6);
    }
    .experiments-list { display: flex; flex-direction: column; gap: var(--sp-6); }
    .experiment-item {
        display: block;
        text-decoration: none;
        color: inherit;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: var(--bg-subtle);
        transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .experiment-item:hover { border-color: var(--accent); transform: translateY(-2px); }
    .experiment-cover {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        background: var(--border);
    }
    .experiment-body { padding: var(--sp-6); }
    .experiment-tag-row { display: flex; gap: var(--sp-2); margin-bottom: var(--sp-3); }
    .experiment-tag {
        display: inline-flex;
        align-items: center;
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--text-secondary);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        padding: 3px 10px;
    }
    .experiment-title {
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 400;
        color: var(--text);
        line-height: 1.2;
        margin-bottom: var(--sp-2);
    }
    .experiment-desc {
        font-size: 13px;
        color: var(--text-secondary);
        line-height: 1.5;
        margin-bottom: var(--sp-3);
    }
    .experiment-link {
        font-size: 12px;
        font-weight: 500;
        color: var(--accent);
        text-decoration: none;
        letter-spacing: 0.02em;
    }
</style>

<div class="container">
    <section class="hero">
        <div class="nl-meta">The newsletter</div>
        <h1 class="nl-title">The long game of <em>staying young</em></h1>
        <p class="nl-lead">I left my previous health startup. Now I'm starting from scratch, building my next venture in the open.</p>
        <p class="nl-lead">I share it as it happens, the unfiltered version: the experiments I run on myself, the research, what works and what blows up.</p>
        <p class="nl-lead">Right now that's mostly health and longevity: peptides, tracking, training, and supplements.</p>

        <div class="nl-form">
            <NewsletterEmbed minimal />
        </div>
        <p class="nl-reassure">Join 1,000+ readers. Two emails a month, unsubscribe anytime.</p>

        <HeroFooter currentPath={Astro.url.pathname} />
    </section>

    <div class="nl-section-label">The archive</div>
    <h2 class="nl-section-title">The experiments so far</h2>

    <div class="experiments-list">
        {archive.map((exp, i) => (
            <a href={`/newsletter/${exp.data.slug}`} class="experiment-item">
                {exp.data.cover && (
                    <img class="experiment-cover" src={exp.data.cover} alt={exp.data.title} loading="lazy" />
                )}
                <div class="experiment-body">
                    <div class="experiment-tag-row">
                        <span class="experiment-tag">{exp.data.category}</span>
                        {i === 0 && <span class="experiment-tag">Latest</span>}
                    </div>
                    <div class="experiment-title">{exp.data.title}</div>
                    <div class="experiment-desc">{exp.data.tagline}</div>
                    <span class="experiment-link">Read it &rarr;</span>
                </div>
            </a>
        ))}
    </div>
</div>
</Layout>

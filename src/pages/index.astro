---
import Layout from '../layouts/Layout.astro';
import NewsletterEmbed from '../components/NewsletterEmbed.astro';
import { getCollection } from 'astro:content';

const allExperiments = await getCollection('experiments');
const experiments = allExperiments.filter(e => !e.data.locale || e.data.locale === 'en');
experiments.sort((a, b) => b.data.date.localeCompare(a.data.date));
const aiSummaryPrompt = "Give me a deep, structured profile of Max Guerois using his personal website https://maxguerois.com as the primary source and his current X profile https://x.com/maxguerois as a supporting source. Use the website for factual grounding, and use X to add current voice, interests, and public positioning. Cover these sections: 1) Who he is — age, location, background, and what drives him. 2) Lucis — what the company was, the traction it reached, and Max's role in its early chapter. 3) Full founder journey — Practup, The Arch, Zero Club, Lucis. 4) Health and longevity — his biomarkers, biological age vs chronological age, pace of aging, testosterone and sleep protocols. 5) Current thinking and public voice — themes, interests, and ideas visible on his X profile. 6) Press and public presence.";
const aiSummaryPromptEncoded = encodeURIComponent(aiSummaryPrompt);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Max Guerois",
  "alternateName": "Maxime Guerois",
  "url": "https://maxguerois.com",
  "image": "https://maxguerois.com/profile.jpg",
  "jobTitle": "Founder",
  "age": 29,
  "description": "29-year-old repeat founder based in Paris. Co-founded Lucis, a preventive health startup using bloodwork and AI to catch disease early, operating across France, UK, Ireland and Portugal. Backed by General Catalyst and Y Combinator. Biological age 9.7 years younger, aging 26% slower than average. Publishes open health protocols on testosterone optimization, sleep, and longevity biomarkers.",
  "founder": [
    { "@type": "Organization", "name": "Lucis", "url": "https://lucis.life" },
    { "@type": "Organization", "name": "Zero Club" },
    { "@type": "Organization", "name": "The Arch" },
    { "@type": "Organization", "name": "Practup" }
  ],
  "alumniOf": {
    "@type": "Organization",
    "name": "Y Combinator",
    "url": "https://www.ycombinator.com/companies/lucis"
  },
  "knowsAbout": [
    "preventive health", "longevity", "biomarkers", "biological age",
    "testosterone optimization", "sleep optimization", "biohacking",
    "epigenetics", "DunedinPACE", "PhenoAge", "bloodwork",
    "startup building", "health tech"
  ],
  "sameAs": [
    "https://twitter.com/maxguerois",
    "https://x.com/maxguerois",
    "https://linkedin.com/in/maxguerois",
    "https://instagram.com/maxguerois",
    "https://www.ycombinator.com/companies/lucis"
  ],
  "mainEntityOfPage": "https://maxguerois.com",
  "subjectOf": [
    {
      "@type": "Article",
      "name": "Max Guerois's Biomarkers: Health Baseline",
      "url": "https://maxguerois.com/newsletter/max-biomarkers",
      "description": "Full longevity biomarker snapshot: metabolism, hormones, body composition, strength, and biological age. Biological age 9.7 years younger, aging 26% slower than average, resting heart rate 40 bpm."
    },
    {
      "@type": "Article",
      "name": "31 science-backed tips to fix low testosterone",
      "url": "https://maxguerois.com/newsletter/testosterone"
    },
    {
      "@type": "Article",
      "name": "7 tips for high-quality sleep after 3 months of tracking",
      "url": "https://maxguerois.com/newsletter/sleep"
    }
  ]
};
---
<Layout
    title="Max Guerois — Builder, Thinker"
    description="Max Guerois — 29-year-old repeat founder based in Paris. Co-founded Lucis, a preventive health startup backed by YC and General Catalyst, operating across France, UK, Ireland and Portugal. Biological age 9.7 years younger, aging 26% slower than average. Open protocols on longevity, testosterone, and sleep."
    ogUrl="https://maxguerois.com"
    ogTitle="Max Guerois — Builder, Thinker"
    ogDescription="29-year-old repeat founder based in Paris. Co-founded Lucis, a preventive health startup backed by YC and General Catalyst, operating across France, UK, Ireland and Portugal. Biological age -9.7 yrs."
    structuredData={structuredData}
>

<div class="container">
    <div class="header fade-in">
        <div class="photo-slider js-slider" style="margin-bottom: 28px;">
            <div class="photo-viewport js-viewport">
                <div class="photo-track js-track">
                    <figure class="photo-slide js-slide"><img src="/health-journey/surf-costarica.jpeg" alt="Surfing in Costa Rica" loading="eager" decoding="async" fetchpriority="high"></figure>
                    <figure class="photo-slide js-slide"><img src="/health-journey/breakfast.jpg" alt="Breakfast plate" loading="lazy" decoding="async"></figure>
                    <figure class="photo-slide js-slide"><img src="/health-journey/workout.jpeg" alt="Training" loading="lazy" decoding="async"></figure>
                    <figure class="photo-slide js-slide"><img src="/health-journey/zeromeetup-182.webp" alt="Ice bath" loading="lazy" decoding="async"></figure>
                    <figure class="photo-slide js-slide"><img src="/health-journey/supplement-breakfast.jpeg" alt="Morning supplements and breakfast" loading="lazy" decoding="async"></figure>
                </div>
            </div>
            <div class="photo-bar">
                <div class="photo-segs js-segs">
                    <button type="button" class="is-active" aria-label="Photo 1"></button>
                    <button type="button" aria-label="Photo 2"></button>
                    <button type="button" aria-label="Photo 3"></button>
                    <button type="button" aria-label="Photo 4"></button>
                    <button type="button" aria-label="Photo 5"></button>
                </div>
            </div>
        </div>
        <div class="name">Max (Maxime) Guerois</div>
        <h1>Just a builder, <em>passionate about health and longevity.</em></h1>
        <p class="intro">
            I'm Max. I'm 29, and my biological age is 19.
            I previously founded <strong>Lucis</strong>, Europe's most comprehensive preventive health platform, and grew it from 0 to seven-figure revenue.
            Now I'm building the most measured version of myself.
            This site is the protocol.
        </p>
    </div>

    <hr class="divider fade-in">

    <!-- Newsletter -->
    <div class="section fade-in">
        <div class="section-label">01 / Newsletter</div>
        <a href="/newsletter"><img src="/health-journey/banner-staying-young.jpg" alt="The long game of staying young" width="1200" height="630" loading="lazy" decoding="async" style="display:block;width:100%;height:auto;border-radius:var(--radius-sm);margin-bottom:20px;"></a>
        <p class="ai-prompt-label">I run health experiments and publish my progress and findings publicly. Every week, in your inbox.</p>
        <div class="writing-list">
            {experiments.slice(0, 3).map((exp) => (
                <a href={`/newsletter/${exp.data.slug}`} class="writing-item">
                    <div class="writing-item-content">
                        <div class="writing-title">{exp.data.title}</div>
                        <div class="writing-meta">{exp.data.category} · {exp.data.date}</div>
                    </div>
                    <svg class="writing-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
            ))}
        </div>
        <div style="margin-top: 24px;">
            <NewsletterEmbed />
        </div>
    </div>

    <hr class="divider fade-in">

    <!-- Work -->
    <div class="section fade-in">
        <div class="section-label">02 / Work</div>

        <div class="work-item">
            <div class="work-left">
                <div class="work-top">
                    <span class="work-name">Lucis</span>
                    <span class="work-badge">Co-founder</span>
                </div>
                <div class="work-desc">Preventive health startup backed by General Catalyst and Y Combinator. Helped build the brand, positioning, and early traction across Europe.</div>
                <div class="work-links">
                    <a href="https://lucis.life" class="work-link" target="_blank">lucis.life <span class="arr">↗</span></a>
                    <a href="/newsletter/lucis-chapter" class="work-link">Leaving Lucis <span class="arr">→</span></a>
                </div>
            </div>
            <span class="work-date">2024 – 2025</span>
        </div>

        <div class="work-item">
            <div class="work-left">
                <div class="work-top">
                    <span class="work-name">Zero Club</span>
                    <span class="work-badge">Founder</span>
                </div>
                <div class="work-desc">50K+ members across 20+ countries — Europe's longevity community. Built to find the people obsessed with health optimization. It grew so fast it became Lucis.</div>
            </div>
            <span class="work-date">2024 – 2025</span>
        </div>

        <div class="work-item">
            <div class="work-left">
                <div class="work-top">
                    <span class="work-name">The Arch</span>
                    <span class="work-badge">Founder</span>
                </div>
                <div class="work-desc">Where Web3 founders, operators &amp; talent found each other — across 20+ countries. Proved I could build community at scale. Then I realized health was the community I actually wanted to build.</div>
            </div>
            <span class="work-date">2022 – 2024</span>
        </div>

        <div class="work-item">
            <div class="work-left">
                <div class="work-top">
                    <span class="work-name">Practup</span>
                    <span class="work-badge">Founder</span>
                </div>
                <div class="work-desc">Fitness app to sync your health data and find workout buddies — 50k+ users in France. My first instinct that health &amp; community belonged together.</div>
            </div>
            <span class="work-date">2021 – 2022</span>
        </div>
    </div>

    <hr class="divider fade-in">

    <!-- Press -->
    <div class="section fade-in">
        <div class="section-label">03 / Press</div>
        <div class="writing-list">
            <a href="https://www.generalcatalyst.com/stories/seeding-the-future-with-lucis" class="writing-item" target="_blank">
                <div class="writing-item-content">
                    <div class="writing-title">Seeding the Future with Lucis</div>
                    <div class="writing-meta">General Catalyst · Dec 2025</div>
                </div>
                <svg class="writing-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H7M13 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="https://www.linkedin.com/posts/y-combinator_most-healthcare-systems-wait-until-youre-activity-7407087196601540608-PiFG" class="writing-item" target="_blank">
                <div class="writing-item-content">
                    <div class="writing-title">Most healthcare systems wait until you're sick to act. That's changing.</div>
                    <div class="writing-meta">Y Combinator · Dec 2025</div>
                </div>
                <svg class="writing-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H7M13 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="https://www.dailymail.co.uk/health/article-14515401/lived-biohacker-bryan-johnson-shocking-effects-body.html" class="writing-item" target="_blank">
                <div class="writing-item-content">
                    <div class="writing-title">I lived like biohacker Bryan Johnson for two years — the shocking effects on my body</div>
                    <div class="writing-meta">Daily Mail · Mar 2025</div>
                </div>
                <svg class="writing-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H7M13 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
        </div>
    </div>

    <hr class="divider fade-in">

    <!-- Ask AI -->
    <div class="section fade-in">
        <div class="section-label" style="margin-bottom: 10px;">Ask AI about Max Guerois</div>
        <p class="ai-prompt-label">Dig into my health protocol, founder story, or longevity obsession.</p>
        <div class="ai-links">
            <a href={`https://chatgpt.com/?q=${aiSummaryPromptEncoded}`} class="ai-link" target="_blank">
                <img src="https://www.google.com/s2/favicons?sz=32&domain=chatgpt.com" alt="ChatGPT" class="ai-icon">
                ChatGPT
            </a>
            <a href={`https://claude.ai/new?q=${aiSummaryPromptEncoded}`} class="ai-link" target="_blank">
                <img src="https://www.google.com/s2/favicons?sz=32&domain=claude.ai" alt="Claude" class="ai-icon">
                Claude
            </a>
            <a href={`https://www.perplexity.ai/search?q=${aiSummaryPromptEncoded}`} class="ai-link" target="_blank">
                <img src="https://www.google.com/s2/favicons?sz=32&domain=perplexity.ai" alt="Perplexity" class="ai-icon">
                Perplexity
            </a>
            <a href={`https://x.com/i/grok?text=${aiSummaryPromptEncoded}`} class="ai-link" target="_blank">
                <img src="/grok.svg" alt="Grok" class="ai-icon ai-icon--square">
                Grok
            </a>
        </div>
    </div>

    <hr class="divider fade-in">

    <!-- Contact -->
    <div class="section fade-in">
        <div class="section-label">04 / Say hi</div>
        <div class="contact-links">
            <a href="mailto:hi@maxguerois.com?subject=Hey%20Max" class="contact-link" target="_top" rel="noopener noreferrer">Email</a>
            <a href="https://twitter.com/maxguerois" class="contact-link" target="_blank">Twitter / X</a>
            <a href="https://instagram.com/maxguerois" class="contact-link" target="_blank">Instagram</a>
            <a href="https://linkedin.com/in/maxguerois" class="contact-link" target="_blank">LinkedIn</a>
        </div>
    </div>
</div>

<script is:inline>
    (function () {
        function init(slider) {
            var viewport = slider.querySelector('.js-viewport');
            var track = slider.querySelector('.js-track');
            var slides = slider.querySelectorAll('.js-slide');
            var segs = slider.querySelectorAll('.js-segs button');
            if (!viewport || !track || !slides.length) return;
            var n = slides.length, i = 0, timer = null;
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var noAuto = slider.hasAttribute('data-noautoplay');
            function offset(k) {
                var maxT = track.scrollWidth - viewport.clientWidth;
                var t = Math.min(slides[k].offsetLeft, maxT);
                return t < 0 ? 0 : t;
            }
            function go(k) {
                i = (k + n) % n;
                track.style.transform = 'translateX(' + (-offset(i)) + 'px)';
                for (var s = 0; s < segs.length; s++) segs[s].classList.toggle('is-active', s === i);
            }
            function start() { if (n > 1 && !reduce && !noAuto && !timer) timer = setInterval(function () { go(i + 1); }, 5500); }
            function stop() { if (timer) { clearInterval(timer); timer = null; } }
            for (var s = 0; s < segs.length; s++) {
                (function (idx) { segs[idx].addEventListener('click', function () { go(idx); stop(); start(); }); })(s);
            }
            slider.addEventListener('mouseenter', stop);
            slider.addEventListener('mouseleave', start);
            window.addEventListener('resize', function () { go(i); });
            var dragging = false, startX = 0, base = 0, moved = 0;
            viewport.addEventListener('pointerdown', function (e) {
                dragging = true; startX = e.clientX; base = -offset(i); moved = 0;
                track.style.transition = 'none'; stop();
                try { viewport.setPointerCapture(e.pointerId); } catch (err) {}
            });
            viewport.addEventListener('pointermove', function (e) {
                if (!dragging) return; moved = e.clientX - startX;
                track.style.transform = 'translateX(' + (base + moved) + 'px)';
            });
            function endDrag() {
                if (!dragging) return; dragging = false; track.style.transition = '';
                if (moved < -45) go(i + 1); else if (moved > 45) go(i - 1); else go(i);
                start();
            }
            viewport.addEventListener('pointerup', endDrag);
            viewport.addEventListener('pointercancel', endDrag);
            viewport.addEventListener('dragstart', function (e) { e.preventDefault(); });
            go(0); start();
        }
        var sliders = document.querySelectorAll('.js-slider');
        for (var j = 0; j < sliders.length; j++) init(sliders[j]);
    })();
</script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const experiments = await getCollection('experiments');
// Sort by date descending (newest first)
experiments.sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Layout
    title="Experiments — Max Guerois"
    description="Health experiments, protocols, and biomarker tracking by Max Guerois. Sleep, testosterone, longevity."
    ogUrl="https://maxguerois.com/experiments"
    ogImage="https://maxguerois.com/health-journey/og/bloodwork.jpg"
    extraStyles={["/styles/article.css"]}
>

<style>
    .experiments-header {
        padding: var(--sp-12) 0 var(--sp-8);
    }
    .experiments-meta {
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: 10px;
    }
    .experiments-title {
        font-family: var(--font-display);
        font-size: clamp(28px, 4vw, 38px);
        font-weight: 400;
        line-height: 1.2;
        color: var(--text);
        margin: 0 0 var(--sp-4);
    }
    .experiments-intro {
        font-size: 16px;
        color: var(--text-secondary);
        line-height: 1.7;
        max-width: 520px;
        margin: 0;
    }
    .experiments-list {
        margin: 40px 0 0;
        border-top: 1px solid var(--border);
    }
    .experiment-item {
        display: block;
        padding: 22px 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
        transition: opacity var(--duration-short) ease;
    }
    .experiment-item:hover {
        opacity: 0.7;
    }
    .experiment-tag {
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: 6px;
    }
    .experiment-title {
        font-family: var(--font-display);
        font-size: 20px;
        font-weight: 500;
        color: var(--text);
        line-height: 1.3;
        margin-bottom: 6px;
    }
    .experiment-desc {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
    }
    .experiment-arrow {
        display: inline-block;
        margin-left: 4px;
        color: var(--text-tertiary);
        transition: color var(--duration-short) ease, transform var(--duration-short) ease;
    }
    .experiment-item:hover .experiment-arrow {
        color: var(--accent);
        transform: translateX(3px);
    }
    .newsletter-section {
        margin: 60px 0 var(--sp-12);
        padding: var(--sp-8);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
    }
    .newsletter-label {
        font-family: var(--font-body);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: var(--sp-2);
    }
    .newsletter-title {
        font-family: var(--font-display);
        font-size: 22px;
        font-weight: 400;
        color: var(--text);
        margin-bottom: 6px;
        line-height: 1.3;
    }
    .newsletter-subtitle {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 20px;
        line-height: 1.6;
    }
    .newsletter-block {
        min-height: 80px;
    }
</style>

<div class="container">
    <a href="/" class="back">&larr; Back home</a>

    <div class="experiments-header">
        <div class="experiments-meta">Health Experiments</div>
        <h1 class="experiments-title">What I'm tracking and learning</h1>
        <p class="experiments-intro">I run experiments on myself — sleep, hormones, biomarkers — and publish the data. Everything here is honest, sourced, and updated as I learn more.</p>
    </div>

    <div class="experiments-list">
        {experiments.map((exp) => (
            <a href={`/${exp.data.slug}`} class="experiment-item">
                <div class="experiment-tag">{exp.data.category} · {exp.data.date}</div>
                <div class="experiment-title">{exp.data.title} <span class="experiment-arrow">&rarr;</span></div>
                <div class="experiment-desc">{exp.data.tagline}</div>
            </a>
        ))}
    </div>

    <div class="newsletter-section">
        <div class="newsletter-label">Newsletter</div>
        <div class="newsletter-title">Get new experiments in your inbox</div>
        <div class="newsletter-subtitle">I publish occasionally. No noise.</div>
        <div class="newsletter-block">
            <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
            <iframe
                src="https://subscribe-forms.beehiiv.com/2019016e-a00d-4333-886d-911b5e3eb2e6"
                class="beehiiv-embed"
                data-test-id="beehiiv-embed"
                frameborder="0"
                scrolling="no"
                style="width: 100%; max-width: 100%; height: 207px; background-color: transparent;"
            ></iframe>
        </div>
    </div>
</div>
</Layout>

---
// HeroFooter.astro — minimalist Whop-style footer bar pinned to the bottom
// of a hero section. Utility links on the left, socials on the right.
// Carries the canonical #theme-toggle + [data-lang-switch] that Layout's
// inline script binds to, so pages using this set hideFooter on Layout.
import { t, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
    locale?: Locale;
    currentPath: string;
}
const { locale = 'en', currentPath } = Astro.props;
const langHref = locale === 'fr'
    ? getLocalizedPath(currentPath, 'en')
    : getLocalizedPath(currentPath, 'fr');
const year = new Date().getFullYear();
---
<footer class="hero-footer">
    <div class="hf-left">
        <span class="hf-copy">© {year} Max Guerois</span>
        <span class="hf-sep" aria-hidden="true"></span>
        <a
            href={langHref}
            class="hf-link"
            aria-label={t(locale, 'nav.langSwitchLabel')}
            data-lang-switch
        >{t(locale, 'nav.langSwitch')}</a>
        <span class="hf-sep" aria-hidden="true"></span>
        <button class="theme-toggle hf-toggle" id="theme-toggle" aria-label="Toggle dark mode">
            <span id="toggle-icon">☾</span>
        </button>
    </div>
    <div class="hf-right">
        <a href="https://linkedin.com/in/maxguerois" target="_blank" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="https://x.com/maxguerois" target="_blank" aria-label="X">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://instagram.com/maxguerois" target="_blank" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
    </div>
</footer>

<style>
    .hero-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--sp-4);
        width: 100%;
        margin-top: auto; /* pin to bottom of a flex-column hero */
        padding: var(--sp-6) 0;
        border-top: 1px solid var(--border);
    }
    .hf-left {
        display: flex;
        align-items: center;
        gap: var(--sp-4);
        flex-wrap: wrap;
    }
    .hf-copy {
        font-family: var(--font-body);
        font-size: 12px;
        letter-spacing: 0.03em;
        color: var(--text-tertiary);
    }
    .hf-link {
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .hf-link:hover { color: var(--text); }
    .hf-sep {
        width: 1px;
        height: 12px;
        background: var(--border);
    }
    .hf-toggle.theme-toggle {
        border: none;
        min-width: 0;
        min-height: 0;
        padding: 4px;
        font-size: 14px;
        background: transparent;
        color: var(--text-secondary);
        cursor: pointer;
        line-height: 1;
    }
    .hf-right {
        display: flex;
        align-items: center;
        gap: 20px;
    }
    .hf-right a {
        color: var(--text-tertiary);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s ease;
    }
    .hf-right a:hover { color: var(--text); }
    .hf-right svg { width: 18px; height: 18px; display: block; }

    @media (max-width: 600px) {
        .hero-footer {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--sp-4);
        }
    }
</style>

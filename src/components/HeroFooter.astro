---
// HeroFooter.astro — a slim bar fixed to the bottom of the viewport on hero
// pages. Holds only the language switch (left) and social icons (right).
// Visible while at the top of the page; fades out as soon as you scroll.
import { t, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/utils';

interface Props {
    locale?: Locale;
    currentPath: string;
}
const { locale = 'en', currentPath } = Astro.props;
const langHref = locale === 'fr'
    ? getLocalizedPath(currentPath, 'en')
    : getLocalizedPath(currentPath, 'fr');
---
<div class="hero-dock" data-hero-dock>
    <div class="hero-dock-inner">
        <a
            href={langHref}
            class="hd-lang"
            aria-label={t(locale, 'nav.langSwitchLabel')}
            data-lang-switch
        >{t(locale, 'nav.langSwitch')}</a>
        <div class="hd-social">
            <a href="https://linkedin.com/in/maxguerois" target="_blank" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://x.com/maxguerois" target="_blank" aria-label="X">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href="https://instagram.com/maxguerois" target="_blank" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
        </div>
    </div>
</div>

<style>
    .hero-dock {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 50;
        pointer-events: none; /* let clicks fall through the empty bar area */
        border-top: 1px solid var(--border); /* full-width divider */
        will-change: opacity, transform;
        transition: opacity 0.18s ease-out, transform 0.18s ease-out;
    }
    .hero-dock-inner {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: var(--sp-4) var(--sp-6) var(--sp-6);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .hd-lang {
        pointer-events: auto;
        font-family: var(--font-body);
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .hd-lang:hover { color: var(--text); }
    .hd-social {
        pointer-events: auto;
        display: flex;
        align-items: center;
        gap: 20px;
    }
    .hd-social a {
        color: var(--text-tertiary);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s ease;
    }
    .hd-social a:hover { color: var(--text); }
    .hd-social svg { width: 18px; height: 18px; display: block; }
</style>

<script is:inline>
    (function () {
        var dock = document.querySelector('[data-hero-dock]');
        if (!dock) return;
        var onScroll = function () {
            var hide = window.scrollY > 8;
            dock.style.opacity = hide ? '0' : '1';
            dock.style.transform = hide ? 'translateY(14px)' : 'translateY(0)';
            dock.style.pointerEvents = hide ? 'none' : '';
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
    })();
</script>

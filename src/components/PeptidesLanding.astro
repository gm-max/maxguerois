---
/**
 * La landing peptides, rendue a DEUX URL.
 *
 * `/peptides` est la canonique. `/fr/peptides` sert le MEME contenu, en place
 * et sans redirection : un seul fichier, donc les deux URL ne peuvent pas se
 * desynchroniser. Une 301 avait ete posee puis retiree, parce qu'elle vit dans
 * vercel.json et ne s'applique donc qu'en production : en local et en preview
 * l'ancienne adresse renvoyait un 404 que personne ne pouvait tester.
 *
 * Le doublon de contenu est neutralise par le canonical, qui pointe toujours
 * sur /peptides quelle que soit l'URL demandee.
 */
interface Props {
    /** Toujours '/peptides' pour le canonical, quelle que soit l'URL servie. */
    canonicalPath?: string;
}
const { canonicalPath = '/peptides' } = Astro.props;
/**
 * La landing du funnel Instagram, recentree sur les GLP-1 le 27/09.
 *
 * Plan : docs/designs/2026-08-26-fr-peptides-landing.md
 * Maquette : ~/.gstack/projects/gm-max-maxguerois/designs/
 *            fr-newsletter-personne-dabord-20260826/sketch-v7-mobile.html
 *
 * Trois choses que cette page fait différemment du reste du site, chacune pour
 * une raison écrite dans le plan :
 *
 * 1. `emailModal={false}` — la modale beehiiv du site entier est supprimée ici,
 *    la page a la sienne, qui offre le guide et poste chez nous (D5, D19, D25).
 * 2. Pas de `hideFooter` — donc le vrai footer de Layout se rend. `HeroFooter`
 *    est un dock `position: fixed` qui s'efface au scroll, il n'a rien à faire
 *    sur une page qui scrolle sur six blocs (D30).
 * 3. La photo sort de `.container`, sinon elle hérite de 24px de gouttière et
 *    cesse d'être un bandeau (audit padding du 26/08).
 */
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const locale = 'fr';

// Same codes as /api/subscribe. Duplicated on purpose rather than shared: the route
// is server-only and this page must render without importing it.
const ERROR_MESSAGES: Record<string, string> = {
    invalid_email: "Cet email n'a pas l'air valide.",
    _: "Ça n'a pas marché de notre côté. Réessayez, ou écrivez-moi à hi@maxguerois.com.",
};
const params = Astro.url.searchParams;
const submitted = params.get('ok') === '1';
const submitErrorCode = params.get('error');
const submitError = submitErrorCode
    ? (ERROR_MESSAGES[submitErrorCode] ?? ERROR_MESSAGES._)
    : null;
const DONE_TEXT = "Le guide arrive, pensez aux spams.";

// Les 3 DERNIERS articles, tries par date. La liste etait choisie a la main :
// elle demandait donc une modification du code a chaque publication, et elle
// avait deja pris du retard.
//
// Une seule categorie est ecartee. Une note de fondateur ne sert pas un lecteur
// venu pour les avancees medicales, et c'est le seul cas ou trier par date seule se
// trompe vraiment. Ajouter une categorie ici si le cas se represente.
const HORS_SUJET = ['Fondateur'];

// La phrase affichee sous chaque titre vient du champ `takeaway` de l'article,
// avec le `tagline` en repli. Elle vit DANS l'article et non ici : une table
// cote code aurait demande une modification a chaque publication, ce que la
// selection automatique venait justement de supprimer.

const all = await getCollection('experiments');
const articles = all
    .filter((e) => e.data.locale === 'fr' && !HORS_SUJET.includes(e.data.category))
    // Dates au format ISO, donc l'ordre alphabetique EST l'ordre chronologique.
    .sort((a, b) => b.data.date.localeCompare(a.data.date))
    .slice(0, 3);

const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const HERO = '/health-journey/max-peptides-hero.jpg';

/**
 * Le ton d'une pastille vient de la CATEGORIE et non du hasard. Les trois tons
 * partagent aujourd'hui le lavis d'ambre du site (direction A, 27/09) : la
 * distinction existe dans le code, pas encore a l'ecran. Elle se rallume en
 * redonnant sa couleur a `.pep-chip--clay` et `--olive`, sans toucher au HTML.
 * Une categorie inconnue retombe sur l'ambre, donc publier une nouvelle
 * categorie ne casse rien.
 */
const CHIP_TONE: Record<string, string> = { 'GLP-1': 'clay', Sommeil: 'olive' };
const chipTone = (c: string) => CHIP_TONE[c] ?? 'amber';
---
<Layout
    title="La médecine derrière les GLP-1 — Max Guerois"
    description="Ensemble, nous cassons les mythes derrière ces nouveaux médicaments. Nous décortiquons la science, sans jargon, avec des mots simples. Par Max Guerois, entrepreneur."
    ogUrl={`https://maxguerois.com${canonicalPath}`}
    ogImage={`https://maxguerois.com${HERO}`}
    ogImageAlt="Max Guerois"
    locale={locale}
    emailModal={false}
    standalone

>

<style>
    /* ── Échelle typo : six pas, deux familles, tous dans DESIGN.md ──
       Aucune taille en dur ailleurs dans cette feuille. */
    .pep {
        --t-h1: 38px;
        --t-h2: 30px;   /* 24 avant le 27/09 : un titre de section pesait
                           exactement autant qu'un titre d'article, donc la
                           page n'avait plus de plan a la lecture rapide. */
        --t-item: 16px;
        --t-body: 16px;   /* jamais < 16px : Safari iOS zoome sur tout input en dessous */
        --t-cal: 14px;
        --t-micro: 13px;
        --t-label: 12px;
        /* Hauteur de la navbar, recopiee de nav.css:12. La navbar est
           position:fixed et body n'a aucun padding-top, donc une image collee
           a y=0 passe sous la barre. Ici elle y perdait la tete du sujet. */
        --pep-nav-h: 56px;

        /* Un seul lavis d'accent, celui du site. Direction A, choisie le
           27/09 : la structure s'allege, la palette ne bouge pas. */
        --pep-accent-wash: rgba(196, 147, 74, 0.14);
        --pep-accent-ink: #8a6327;
    }
    :global([data-theme='dark']) .pep { --pep-accent-ink: #dcae69; }
    @media (min-width: 601px) { .pep { --t-h1: 52px; } }

    /* ── HÉROS ──
       Mobile : photo en bandeau pleine largeur, texte dessous.
       ≥900px : deux colonnes, texte à gauche, photo verticale à droite.

       Pourquoi une composition et pas un simple plafond de hauteur : la photo
       est pleine largeur, donc sa hauteur suit la LARGEUR du viewport. Mesuré
       sur 1280x820 avant correction : image 720px, soit 88% du premier écran,
       et le bouton à y=1091, donc 271px SOUS la ligne de flottaison. Plus
       l'écran est large, pire c'est. Des colonnes bornent le problème au lieu
       de le repousser. */
    .pep-hero { margin-top: var(--pep-nav-h); }
    /* Le texte et la photo se suivent desormais : il leur faut une respiration
       que la disposition en colonnes rendait inutile. */
    .pep-hero-img { margin-top: var(--sp-8); }
    /* 48px au-dessus du titre, 64px au-dela de 600px. Le sur-titre
       « Max Guerois · Newsletter » a ete retire le 21/09 : il portait a lui
       seul l'ecart avec la navbar, et sans lui le titre tombait a 24px de la
       barre, colle. */
    .pep-hero-body { padding: var(--sp-12) var(--sp-6) 0; }
    @media (min-width: 601px) { .pep-hero-body { padding-top: var(--sp-16); } }
    /* Plus de grille deux colonnes au-dessus de 1280.
       Elle produisait une boite dont le rapport derivait avec la fenetre, de
       0,73 a 1,24, sans jamais coincider avec le 1,50 de la photo : mesure,
       51% de l'image jetee a 1280. Un panneau pleine hauteur qui deborde a
       droite demande une source portrait, la photo est paysage. Le bandeau la
       montre entiere. */

    /* aspect-ratio + width/height sur la balise : la place est réservée avant
       le chargement, donc aucun décalage de mise en page. */
    .pep-hero-img {
        display: block;
        width: 100%;
        /* `height: auto` n'est PAS decoratif. L'attribut height="733" de la
           balise est une hauteur presentationnelle : avec width:100% la boite
           avait deux dimensions definies, donc aspect-ratio etait ignore et
           l'image se rendait en 375x733 au lieu de 375x250. Resultat mesure :
           le formulaire tombait a y=1099 sur un viewport de 812, donc sous la
           ligne de flottaison, ce qui est exactement ce que la page ne doit
           pas faire. Les attributs restent pour reserver la place au
           chargement. */
        height: auto;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        object-position: 38% 40%;
        background: var(--bg-subtle);
    }
    /* Entre 601 et 1279px, la photo reste un bandeau. La composition en deux
       colonnes n'a la place de respirer qu'au-dela : la colonne image vaut
       largeur/2 - 334, soit 166px sur un ecran de 1000. Un ruban vertical.
       Le plafond de hauteur n'est pas cosmetique : en 1000x800 sans lui,
       l'image faisait 667px et le bouton tombait a y=981, sous le pli. */
    /* Plus de plafond haut : la regle vaut pour TOUTE largeur au-dessus de
       601px. Bornee a 1279 elle laissait les grands ecrans retomber sur la
       regle de base, donc pleine fenetre : un 3/2 sur un 1512 fait 1008px de
       haut et enterre le formulaire. */
    @media (min-width: 601px) {
        /* Le plafond de hauteur precedent ramenait le 3/2 de la source a 2,65
           mesure a 900px de large : 43% de la photo jetee. Il a disparu avec
           lui. L'image garde son rapport natif et se cale sur la colonne de
           texte, comme tout le reste de la page.
           Elle ne s'etale plus sur toute la fenetre : en pleine largeur sur un
           1512, un 3/2 ferait 1008px de haut et pousserait tout sous la ligne
           de flottaison. */
        .pep-hero-img {
            /* Largeur de CONTENU et non de boite. `.pep-hero-body` est en
               border-box a 620px avec 24px de padding, donc son texte commence
               24px plus a droite : cale sur 620, l'image debordait de 24px a
               gauche du texte qu'elle accompagne. Meme piege que sur le
               bandeau. */
            max-width: calc(var(--content-width) - var(--sp-6) * 2);
            margin-left: auto;
            margin-right: auto;
            border-radius: var(--radius-sm);
        }
        /* Le texte du heros doit rester sur le meme axe que les sections en
           dessous. Sans ca, entre 601 et 1279px il commencait a 24px du bord
           pendant que `.container` centrait sa colonne de 620px : 190px de
           derive mesures sur un ecran de 1000. */
        .pep-hero-body {
            max-width: var(--content-width);
            margin: 0 auto;
        }
    }

    .pep { font-size: var(--t-body); }

    .pep h1 {
        font-family: var(--font-display);
        font-weight: 300;
        font-size: var(--t-h1);
        line-height: 1.08;
        letter-spacing: -0.01em;
        margin: 0 0 var(--sp-3);
        color: var(--text);
    }
    .pep h1 em { font-style: italic; color: var(--accent); }

    .pep-sub {
        font-size: var(--t-body);
        color: var(--text-secondary);
        line-height: 1.6;
        margin: 0;
        max-width: 34em;
    }

    .pep-section { margin-top: var(--sp-16); }

    /* `:global` obligatoire, pas un raccourci. Astro scope les styles PAR
       composant : sans lui, ce selecteur devient `.pep-section[cid-parent] >
       .nlb[cid-parent]`, or `.nlb` appartient au composant bandeau et porte un
       AUTRE identifiant. La regle ne matchait rien et l'ecart mesurait 0.
       La marge vit ici et non dans le bandeau : un composant ne doit pas
       decider de ce qui l'entoure. */
    .pep-section > :global(.nlb) { margin-bottom: var(--sp-6); }
    @media (min-width: 601px) { .pep-section { margin-top: var(--sp-20); } }

    /* Selecteur a DEUX classes, volontairement. En une seule (0,1,0) il
       perdait contre toute regle de section du type `.pep-x p` (0,1,1). C'est
       ce qui rendait le label « Ma mission » en 16px noir plein au lieu de
       12px tertiaire. La cause racine est retiree, cette specificite immunise
       contre la prochaine. */
    .pep .pep-label {
        font-family: var(--font-body);
        font-size: var(--t-label);
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin: 0 0 var(--sp-3);
    }
    /* Graisse 500 et non 400. A 24px, Cormorant 400 a des futs plus fins que
       DM Sans 400 : le h2 ne gagnait que 15% de hauteur d'x sur le corps et
       lisait comme une premiere phrase, pas comme un titre. Le poids 500 est
       deja charge par Layout.astro, aucune requete de fonte en plus. */
    .pep h2 {
        font-family: var(--font-display);
        /* 400, la valeur de DESIGN.md. La page etait passee en 500 sans
           raison ecrite, et une page qui a ses propres regles est une page
           qui sortira du systeme au prochain changement. */
        font-weight: 400;
        font-size: var(--t-h2);
        line-height: 1.2;
        margin: 0 0 var(--sp-4);
        color: var(--text);
    }
    .pep-text {
        font-size: var(--t-body);
        color: var(--text-secondary);
        line-height: 1.7;
        margin: 0 0 var(--sp-4);
    }

    /* ── Lignes : preuves ET articles partagent UN composant (Writing Item,
       DESIGN.md), sans l'encapsulation en carte. ── */
    /* ── Pastille de categorie. La couleur vient de la categorie de
       l'article, donc elle apprend quelque chose au lecteur des la deuxieme
       ligne : terre cuite, c'est un GLP-1. ── */
    .pep-chip {
        display: inline-block;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: var(--radius-full);
    }
    /* Noir sur fond sourd. Le dore ne touche plus un seul texte de la page
       (regle du 27/09) : il ne reste que sur le bouton, qui est une action. */
    .pep-chip--clay,
    .pep-chip--olive,
    .pep-chip--amber { background: var(--bg-subtle); color: var(--text); }
    .pep-row-date { font-size: var(--t-label); color: var(--text-tertiary); margin-left: var(--sp-2); }

    /* Bouton secondaire : contour seul, jamais de remplissage. Le bouton
       plein est reserve a l'inscription, qui est l'action de la page ; deux
       boutons pleins se disputeraient le meme regard.
       48px de haut, donc au-dessus des 44px de cible tactile. */
    .pep-all {
        display: inline-flex;
        align-items: center;
        gap: var(--sp-2);
        min-height: 48px;
        margin-top: var(--sp-6);
        padding: 0 var(--sp-6);
        font-size: var(--t-body);
        font-weight: 500;
        color: var(--text);
        text-decoration: none;
        background: transparent;
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        transition: background var(--duration-short) var(--ease-out),
                    border-color var(--duration-short) var(--ease-out);
    }
    .pep-all:hover { background: var(--bg-subtle); border-color: var(--text-tertiary); }

    /* ── Qui je suis ── */
    .pep-me h2 { margin-bottom: var(--sp-6); }
    .pep-me-img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        object-position: 38% 40%;
        border-radius: var(--radius-md);
        margin-bottom: var(--sp-6);
        background: var(--bg-subtle);
    }
    /* ── Les articles, avec leur banniere ──
       La liste etait en texte seul. La banniere est ce que le lecteur
       reconnait d'un reel a l'autre, et c'est elle qui fait cliquer. */
    .pep-posts { margin-top: var(--sp-6); }
    .pep-post {
        display: block;
        padding: var(--sp-8) 0;
        border-top: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
    }
    .pep-post:first-child { border-top: 0; padding-top: 0; }
    /* ── L'overlay des bannieres ──
       Les couvertures viennent de sources tres differentes : une facade de
       McDonald's en plein jour, un tarmac au coucher du soleil, une chambre de
       nuit. Cote a cote, elles ne font pas une liste, elles font un patchwork.
       Un voile degrade sombre, pose en bas et transparent en haut, leur donne
       un pied commun sans rien masquer du sujet. Il s'eclaircit au survol :
       l'image repond au pointeur, ce qui dit qu'elle est cliquable. */
    .pep-post-media {
        display: block;
        position: relative;
        margin-bottom: var(--sp-4);
        border-radius: var(--radius-md);
        overflow: hidden;
        /* Sans ca, l'image debordait des coins arrondis sur Safari. */
        isolation: isolate;
    }
    .pep-post-img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        background: var(--bg-subtle);
    }
    .pep-post-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(15, 14, 12, 0.55) 0%,
            rgba(15, 14, 12, 0.18) 38%,
            rgba(15, 14, 12, 0) 68%
        );
        transition: opacity var(--duration-base) var(--ease-out);
    }
    .pep-post:hover .pep-post-scrim { opacity: 0.55; }
    @media (prefers-reduced-motion: reduce) {
        .pep-post-scrim { transition: none; }
    }
    .pep-post-meta { display: block; margin-bottom: var(--sp-2); }
    /* 24px, donc un cran SOUS le titre de section (30px) : c'est ce qui
       distingue un contenu d'un repere. Marges remises a zero, un h3 en
       porte par defaut. */
    .pep-post-t {
        display: block;
        margin: 0;
        font-family: var(--font-display);
        font-weight: 400;
        font-size: 24px;
        line-height: 1.2;
        color: var(--text);
    }
    .pep-post:hover .pep-post-t { text-decoration: underline; }

    /* ── Les articles suivants, en ligne ──
       Vignette carree a gauche, texte a droite : trois lignes tiennent dans
       l'espace qu'une seule banniere occupait. */
    .pep-mini {
        display: flex;
        gap: var(--sp-4);
        align-items: flex-start;
        padding: var(--sp-6) 0;
        border-top: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
    }
    .pep-mini-img {
        flex: 0 0 76px;
        width: 76px;
        height: 76px;
        object-fit: cover;
        border-radius: var(--radius-sm);
        background: var(--bg-subtle);
    }
    .pep-mini-body { display: block; min-width: 0; }
    .pep-mini-cat {
        display: block;
        font-size: var(--t-label);
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: var(--sp-2);
    }
    /* Police de CORPS et non de titre : a 16px, Cormorant rendrait plus petit
       que la date qui le suit (hauteur d'x de 0,386 contre 0,504). */
    .pep-mini-t {
        margin: 0 0 var(--sp-2);
        font-family: var(--font-body);
        font-weight: 500;
        font-size: var(--t-item);
        line-height: 1.4;
        color: var(--text);
    }
    .pep-mini:hover .pep-mini-t { text-decoration: underline; }
    .pep-mini .pep-row-date { margin-left: 0; display: block; }
    .pep-post-d {
        display: block;
        margin-top: var(--sp-2);
        font-size: var(--t-cal);
        line-height: 1.6;
        color: var(--text-secondary);
    }

    .pep-rows { border-top: 1px solid var(--border); }
    .pep-row {
        display: block;
        padding: var(--sp-4) 0;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
        color: inherit;
    }
    a.pep-row { padding: var(--sp-6) 0; }
    a.pep-row:hover .pep-row-t { color: var(--accent); }

    /* Le formulaire qui suit porte DEJA son propre filet superieur. Sans cette
       regle, la derniere ligne fermait avec le sien : deux traits separes par
       48px de vide, pour une seule separation. L'ancienne liste numerotee
       n'avait pas de filet de cloture, d'ou l'apparition du doublon.
       Classe explicite plutot qu'un `:has(+ .pep-inline)` : le selecteur malin
       marcherait, mais celui qui lira ce fichier dans six mois verra la classe
       dans le HTML, pas une condition cachee dans la feuille. */
    .pep-rows--menu .pep-row:last-child { border-bottom: 0; }
    /* Police de CORPS, pas de titre. Cormorant a une hauteur d'x de 0,386 em
       contre 0,504 pour DM Sans : a 16px il rendait 6,18px de hauteur d'x,
       soit MOINS que les 6,55px de .pep-row-d en 13px. Le titre etait
       optiquement plus petit que sa propre description. La police de titre ne
       repasse au-dessus du corps qu'a partir de 20,9px. */
    .pep-row-t {
        display: block;
        font-family: var(--font-body);
        font-weight: 500;
        font-size: var(--t-item);
        line-height: 1.5;
        color: var(--text);
        transition: color var(--duration-short) var(--ease-out);
    }
    .pep-row-d {
        display: block;
        font-size: var(--t-micro);
        color: var(--text-secondary);
        line-height: 1.6;
        margin-top: 2px;
    }
    .pep-row-d a {
        color: var(--text-secondary);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--accent-mid);
    }
    a.pep-row .pep-row-d { margin-top: var(--sp-2); margin-bottom: var(--sp-3); }
    .pep-row-meta {
        display: block;
        font-size: var(--t-micro);
        color: var(--text-tertiary);
    }



    /* ── Les trois cartes de « Qui suis-je » ──
       UNE colonne a toute largeur, demande du 27/09 : empilees, elles se
       lisent dans l'ordre, et le meme rythme tient du telephone au grand
       ecran. Elles reprennent la Callout Box de DESIGN.md : bordure,
       radius-lg, aucun remplissage.
       `background: var(--bg)` est explicite et non herite : sans lui, une
       carte posee plus tard sur un fond sourd deviendrait transparente et se
       fondrait dedans. */
    .pep-cards {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--sp-4);
    }
    /* L'icone au TRAIT, sans cercle ni carre autour (choix du 27/09).
       L'icone dans une pastille coloree est la signature des pages generees a
       la chaine ; au trait fin et en encre tertiaire, elle distingue les trois
       points sans se voir avant eux. Purement decorative, donc `aria-hidden` :
       le titre de la carte dit deja tout a un lecteur d'ecran. */
    .pep-card-ico { color: var(--text-tertiary); margin-bottom: var(--sp-3); }

    .pep-card {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: var(--sp-6);
    }
    /* La categorie reutilise .pep-label : meme role de micro-label, donc meme
       traitement. Seule la marge se resserre dans une carte. */
    .pep-card .pep-label { margin-bottom: var(--sp-2); }
    /* Police de corps, meme raison que .pep-row-t : sous 20,9px la police de
       titre rend plus petit que le corps. */
    .pep-card-t {
        font-family: var(--font-body);
        font-weight: 500;
        font-size: var(--t-item);
        line-height: 1.3;
        color: var(--text);
        margin: 0 0 var(--sp-2);
    }
    .pep-card-d {
        font-size: var(--t-micro);
        line-height: 1.6;
        color: var(--text-secondary);
        margin: 0;
    }

    /* Une idee par ligne : l'affirmation en pleine force, sa justification en
       secondaire juste dessous, puis 48px de vide avant la suivante. C'est ce
       vide qui repond au « trop packed » : sans lui les lignes se lisent comme
       un seul pave. */
    .pep-line {
        font-size: var(--t-body);
        line-height: 1.55;
        color: var(--text);
        margin: 0 0 var(--sp-2);
    }
    .pep-dim {
        font-size: var(--t-body);
        line-height: 1.6;
        color: var(--text-secondary);
        margin: 0 0 var(--sp-12);
    }
    .pep-line:last-child,
    .pep-dim:last-child { margin-bottom: 0; }
    /* Text Highlight — composant DESIGN.md, réutilise --accent-light. */
    .mark {
        background: var(--accent-light);
        box-shadow: 0 0 0 3px var(--accent-light);
        border-radius: 2px;
    }

    /* ── Cloture sur fond encre. Pleine largeur : une bande sombre qui
       s'arrete a 24px du bord serait une carte, pas une fin de page. ── */
    /* Le formulaire du pic d'intention, isolé de la liste 1-2-3. Sans ce filet
       les deux blocs se collent et la section a l'air de se répéter. */
    .pep-inline { margin-top: var(--sp-12); padding-top: var(--sp-8); border-top: 1px solid var(--border); }

    /* ── Formulaire ── */
    .pf-label {
        display: block;
        font-family: var(--font-body);
        font-size: var(--t-label);
        font-weight: 500;
        /* Aligne sur .pep-label : meme role de micro-label, meme traitement. */
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin: 0 0 var(--sp-2);
    }
    .pf-row { display: flex; flex-direction: column; gap: var(--sp-2); }
    @media (min-width: 601px) {
        /* 560 et non 480 : avec le libelle raccourci le bouton fait ~215px, il
           reste donc ~337px au champ. L'email est ce qu'on demande, il doit etre
           l'element le plus large de la rangee. Avant : champ 181, bouton 291. */
        .pf-row { flex-direction: row; max-width: 560px; }
        .pf-row input { flex: 1 1 auto; min-width: 0; }
    }
    .pf-row input {
        width: 100%;
        height: 48px;
        padding: 0 var(--sp-4);
        font-family: var(--font-body);
        font-size: var(--t-body);
        color: var(--text);
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-full);
        transition: border-color var(--duration-short) var(--ease-out);
    }
    .pf-row input::placeholder { color: var(--text-tertiary); }
    .pf-row input[aria-invalid='true'] { border-color: var(--accent); }
    .pf-row button {
        height: 48px;
        /* Le bouton ne se comprime pas : son libelle est en `nowrap`, le
           reduire le ferait deborder de sa propre boite. C'est le CHAMP qui
           absorbe la variation de largeur. */
        flex-shrink: 0;
        padding: 0 22px;
        font-family: var(--font-body);
        font-size: var(--t-body);
        font-weight: 500;
        /* #1a1a1a, jamais #fff : blanc sur l'ambre = 2,76:1, échoue WCAG AA
           (DESIGN.md, 2026-08-26). */
        color: #1a1a1a;
        background: var(--accent);
        border: 0;
        border-radius: var(--radius-full);
        cursor: pointer;
        white-space: nowrap;
        transition: opacity var(--duration-short) var(--ease-out);
    }
    @media (max-width: 600px) { .pf-row button { width: 100%; } }
    .pf-row button[disabled] { opacity: 0.6; cursor: default; }
    .pf-err {
        margin: var(--sp-2) 0 0;
        font-size: var(--t-micro);
        color: var(--accent);
        line-height: 1.5;
    }
    .pf-micro {
        margin: var(--sp-3) 0 0;
        font-size: var(--t-micro);
        color: var(--text-tertiary);
        line-height: 1.5;
    }
    /* Honeypot. Jamais display:none — certains lecteurs d'écran et surtout
       certains bots traitent display:none comme « à ignorer », or on veut que
       le bot le voie et le remplisse. */
    .pf-hp {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        opacity: 0;
    }
    .pf-done {
        margin: 0;
        font-size: var(--t-body);
        line-height: 1.6;
        color: var(--text);
    }
    .pf-done b { font-weight: 500; }

    /* ── Pop-up guide ──
       Le <dialog> EST la carte. Le voile est ::backdrop, que le navigateur
       dimensionne au viewport entier, gratuitement.

       Ce que faisait la version precedente, et pourquoi elle etait cassee en
       production, mesure sur maxguerois.com en 1280x820 :

       1. `.pg[open] { display: block }` etait ecrit AVANT `.pg { display: flex }`.
          `[open]` a une specificite plus forte, donc `block` gagnait et le
          centrage n'a jamais rien fait : carte collee a top:28px.
       2. Le voile etait peint sur le <dialog> lui-meme, avec `::backdrop` mis a
          `transparent`. Or `inset: 0` n'etire une dimension que si elle vaut
          `auto` : `width` etait fixe, `height` restait auto, donc le voile
          s'arretait a la hauteur du contenu. Mesure : 302px sur 820.
       3. Consequence : 518px de page qui paraissaient normaux, couverts par le
          ::backdrop invisible du navigateur, donc inertes. On clique, rien ne
          repond, ni la modale ni la page. Indiscernable de "je ne peux pas la
          fermer".

       Le centrage se fait maintenant par `inset: 0` + `margin: auto`, qui ne
       depend d'aucun display et marche donc quoi que fasse l'UA. */
    .pg {
        position: fixed;
        inset: 0;
        margin: auto;
        width: min(420px, calc(100% - var(--sp-8)));
        max-width: none;
        height: fit-content;
        max-height: calc(100dvh - var(--sp-8));
        padding: 0;
        border: 0;
        background: transparent;
        overflow: visible;
    }
    .pg::backdrop { background: rgba(26, 26, 26, 0.45); }
    /* En sombre, le fond du site est #0f0e0c, plus sombre que le rgb(26,26,26)
       du voile : celui-ci ECLAIRCISSAIT la page au lieu de l'assombrir. Le
       :global() est necessaire, l'attribut data-theme vit sur <html>, hors de
       la portee du style scope de ce composant. */
    :global([data-theme='dark']) .pg::backdrop { background: rgba(0, 0, 0, 0.62); }
    .pg-card {
        position: relative;
        max-height: calc(100dvh - var(--sp-8));
        overflow-y: auto;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: var(--sp-6);
        animation: pg-rise var(--duration-base) var(--ease-out);
    }
    /* Dans une carte de 420px, la rangee en ligne laissait 71px a l'input parce
       que le bouton est en `nowrap` et prenait 291px. Mesure en production. */
    .pg .pf-row { flex-direction: column; max-width: none; }
    .pg .pf-row button { width: 100%; }
    /* En colonne, la main axis est la HAUTEUR. La regle desktop `flex: 1 1 auto`
       s'applique encore ici et donne au champ une base de 0 : mesure, 23px de
       haut contre 48 pour le bouton. `flex: 0 0 48px` le rend non flexible sur
       cet axe, quelle que soit la regle heritee. */
    .pg .pf-row input { flex: 0 0 48px; }
    @keyframes pg-rise { from { opacity: 0; transform: translateY(12px); } }
    .pg-close {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--t-h2);
        line-height: 1;
        color: var(--text-tertiary);
        background: none;
        border: 0;
        cursor: pointer;
    }
    .pg-close:hover { color: var(--text); }
    .pg-card h2 { margin-bottom: var(--sp-3); padding-right: var(--sp-8); }

    @media (prefers-reduced-motion: reduce) {
        .pg-card { animation: none; }
        .pep-row-t, .pf-row input, .pf-row button { transition: none; }
    }
</style>


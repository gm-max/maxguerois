---
/**
 * Beehiiv newsletter embed — used on homepage, experiments index, and article footers.
 */
import type { Locale } from '../i18n/utils';
import { t } from '../i18n/utils';

interface Props {
    locale?: Locale;
    /** Render only the email input + button (no heading or description). */
    minimal?: boolean;
    /**
     * Emit `data-src` instead of `src`, leaving the caller to start the load.
     * Used by the modal: it only ever shows once per visitor, so on every later
     * visit the iframe would otherwise be fetched for a modal that can never
     * appear. The caller sets src at page load when the modal is still due, so
     * the frame is ready by the time it opens.
     */
    deferSrc?: boolean;
}

const { locale = 'en', minimal = false, deferSrc = false } = Astro.props;
const embedSrc = 'https://subscribe-forms.beehiiv.com/2019016e-a00d-4333-886d-911b5e3eb2e6';
---
<div class:list={["newsletter-block", { "newsletter-block--minimal": minimal }]}>
    {!minimal && (
        <>
            <div class="newsletter-header">
                <span class="newsletter-name">{t(locale, 'newsletter.title')}</span>
            </div>
            <p class="newsletter-desc">{t(locale, 'newsletter.desc')}</p>
        </>
    )}
    {/* Load beehiiv's scripts at most once per page. Two <script src> tags would
        execute embed.js twice and double-bind its resize listener, making the
        iframes race their height. This guard lets multiple embeds coexist. */}
    <script is:inline>
        (function () {
            var srcs = [
                'https://subscribe-forms.beehiiv.com/attribution.js',
                'https://subscribe-forms.beehiiv.com/embed.js'
            ];
            srcs.forEach(function (src) {
                if (document.querySelector('script[src="' + src + '"]')) return;
                var s = document.createElement('script');
                s.src = src;
                s.async = true;
                document.head.appendChild(s);
            });
        })();
    </script>
    {/* Correct beehiiv's no-measurement fallback height.
        Its embed.js writes an inline height on the iframe after measuring. When
        that handshake does not complete it writes 2000px, which is not a
        measurement but a give-up value. Inside the modal the 60vh cap keeps the
        card on screen but leaves it half empty under the Subscribe button; in
        page it inflated .newsletter-block from 205px to 2158px and the homepage
        from 3541px to 5494px.

        Only the exact fallback is touched. Any other height beehiiv writes is a
        real measurement, including the taller confirmation it swaps in after a
        successful subscribe, and passes through untouched. */}
    <script is:inline>
        (function () {
            var FALLBACK = '2000px';
            // DESIGN.md documents 80px as the reserved height for this embed, and
            // the iframe already ships with it inline. Falling back to the
            // documented value beats inventing one: the form measures 47px when
            // beehiiv gets it right, so 80px holds it with room to spare.
            var DOCUMENTED = '80px';
            var script = document.currentScript;
            var frame = script && script.parentElement
                ? script.parentElement.querySelector('iframe.beehiiv-embed') : null;
            if (!frame || typeof MutationObserver !== 'function') return;

            var ours = null;   // guard: our own write must not retrigger us
            new MutationObserver(function () {
                var h = frame.style.height;
                if (h === ours) return;
                if (h === FALLBACK) { ours = DOCUMENTED; frame.style.height = DOCUMENTED; }
                else { ours = null; }
            }).observe(frame, { attributes: true, attributeFilter: ['style'] });
        })();
    </script>
    <iframe
        src={deferSrc ? undefined : embedSrc}
        data-src={deferSrc ? embedSrc : undefined}
        class="beehiiv-embed"
        data-test-id="beehiiv-embed"
        frameborder="0"
        scrolling="no"
        sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-top-navigation-by-user-activation"
        style="width: 100%; max-width: 100%; height: 80px; margin: 0; border-radius: 0px !important; background-color: transparent;"
    ></iframe>
</div>

<style>
    /* Bound the embed at both ends. beehiiv's embed.js measures the iframe and
       writes an inline height; when that handshake misbehaves it lands on one of
       two observed values, both bad:

         2000px  its fallback when it never gets a measurement. Seen on the live
                 homepage, where it inflated .newsletter-block from 205px to
                 2158px and the page from 3541px to 5494px, leaving ~1950px of
                 white space. Reproduced on the pre-modal build too, so it is not
                 caused by having a second embed on the page.
         0px     what it writes when it measures the iframe while it is hidden,
                 which is the modal's case at load. It self-corrects a few
                 seconds after the modal opens, but the form is invisible until
                 it does.

       Neither is reachable now. The healthy value is 47px, well inside these
       bounds, so this rule is inert whenever the handshake works, and it still
       lets beehiiv grow the frame for the taller confirmation it swaps in after
       a successful subscribe.

       Measured 6 consecutive loads at 47px after this was written, so the
       failure is intermittent rather than constant: treat this as a seatbelt,
       not as a fix for a reproducible bug. */
    .newsletter-block :global(iframe.beehiiv-embed) {
        min-height: 47px !important;
        max-height: 60vh !important;
    }
</style>

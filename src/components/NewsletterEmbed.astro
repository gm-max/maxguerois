---
/**
 * Newsletter signup, on our own stack. Used on both homepages, both newsletter
 * indexes, every article footer, and inside SubscribeModal — 24 call sites.
 *
 * This was a beehiiv <iframe> until 2026-08-26. Replacing it deletes the two
 * injected beehiiv scripts, the once-per-page script-dedup guard, the MutationObserver
 * correcting their 2000px no-measurement fallback, and the min/max-height seatbelt —
 * about 100 lines that existed only to compensate for a cross-origin frame we did not
 * control. None of that has an equivalent here because there is no frame.
 *
 * WITHOUT JAVASCRIPT the form posts natively and the route redirects to a thank-you
 * page. That indirection is not decoration: every page carrying this component is
 * PRERENDERED, so it cannot read `?ok=1` at request time and could never render a
 * confirmation. /fr/merci and /thanks are on-demand and can. Sending someone back to
 * a page identical to the one they left is how you make them submit twice, then
 * conclude it is broken.
 *
 * WITH JAVASCRIPT the submit is intercepted, the form is replaced in place by the
 * confirmation, and nothing navigates.
 */
import type { Locale } from '../i18n/utils';
import { t } from '../i18n/utils';

interface Props {
    locale?: Locale;
    /** Render only the email input + button (no heading or description). */
    minimal?: boolean;
    /** Distinguishes where a signup came from, stored in mg_subscribers.source. */
    source?: string;
}

const { locale = 'en', minimal = false, source = 'site' } = Astro.props;

// The route resolves this key against a whitelist; it never accepts a URL. See the
// open-redirect note in src/pages/api/subscribe.ts.
const action = `/api/subscribe?lang=${locale}`;
// Unique per instance: several embeds share a page (index + article footer), and
// duplicate ids would make every <label for> point at the first input on the page.
const uid = `nl-${Math.random().toString(36).slice(2, 9)}`;

/**
 * Is the anti-bot gate armed in THIS build?
 *
 * Read here only to decide whether the <noscript> warning below tells the truth.
 * Without Turnstile a no-JS signup works: the form posts natively and the route
 * redirects to a thank-you page. With Turnstile it cannot, because the token can only
 * come from a script. Saying so is the honest version; letting someone submit into a
 * refusal is not. The client script makes the same call at runtime via
 * `window.mgTurnstile.active`.
 */
const captchaActive = Boolean(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
---
<div class:list={["newsletter-block", { "newsletter-block--minimal": minimal }]}>
    {!minimal && (
        <>
            <div class="newsletter-header">
                <span class="newsletter-name">{t(locale, 'newsletter.title')}</span>
            </div>
            <p class="newsletter-desc">{t(locale, 'newsletter.desc')}</p>
        </>
    )}

    <form class="nl-form" data-nl-form method="POST" action={action}>
        <label class="nl-label" for={uid}>{t(locale, 'newsletter.form.label')}</label>
        <input type="hidden" name="source" value={source} />
        {/* Honeypot. Hidden from sight and from screen readers, never from a bot,
            which fills every input it finds. The route answers 200 and writes
            nothing, so the bot learns nothing from the response either. */}
        <input class="nl-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="nl-row">
            <input
                id={uid}
                name="email"
                type="email"
                required
                inputmode="email"
                autocomplete="email"
                autocapitalize="off"
                spellcheck="false"
                placeholder={t(locale, 'newsletter.form.placeholder')}
                aria-describedby={`${uid}-err`}
            />
            <button type="submit">{t(locale, 'newsletter.form.button')}</button>
        </div>
        <p class="nl-err" role="alert" id={`${uid}-err`} hidden></p>
        <p class="nl-micro">{t(locale, 'newsletter.form.micro')}</p>
        {captchaActive && (
            <noscript>
                <p class="nl-nojs">{t(locale, 'newsletter.form.nojs')}</p>
            </noscript>
        )}
    </form>
</div>

<script is:inline define:vars={{ locale }}>
    (function () {
        var COPY = {
            fr: {
                busy: 'Une seconde…',
                done: "Merci, vous êtes inscrit. Je vous enverrai la prochaine édition quand elle vaudra le détour.",
                err: {
                    invalid_email: 'Cette adresse ne semble pas valide.',
                    // Meme message que l'erreur serveur, volontairement : dire « trop de
        // tentatives » donne a un robot un oracle propre pour calibrer sa
        // cadence. La landing peptides collapse deja les deux.
        rate_limited: "L'inscription a échoué. Réessayez dans un instant.",
                    store_failed: "L'inscription a échoué. Réessayez dans un instant.",
                    // La verification anti-robot. Trois cas, trois messages : le
                    // visiteur doit savoir s'il doit recommencer (son jeton a
                    // expire) ou patienter (Cloudflare ne repond pas), sinon il
                    // reessaie dans le vide. Jamais le mot « captcha » : rien de
                    // tel n'apparait a l'ecran, le widget restant invisible tant
                    // qu'il n'a rien a demander.
                    captcha_required: "La vérification anti-robot n'a pas pu s'exécuter. Rechargez la page et réessayez.",
                    captcha_failed: 'La vérification anti-robot a échoué. Réessayez.',
                    captcha_unavailable: "La vérification anti-robot est indisponible. Réessayez dans un instant, ou écrivez-moi à hi@maxguerois.com.",
                    _: "L'inscription a échoué. Réessayez dans un instant.",
                },
            },
            en: {
                busy: 'One moment…',
                done: "Thanks, you're subscribed. I'll send the next issue when it's worth your attention.",
                err: {
                    invalid_email: "That address doesn't look right.",
                    rate_limited: 'Too many attempts. Try again in a moment.',
                    store_failed: 'Signup failed. Try again in a moment.',
                    captcha_required: "The anti-bot check couldn't run. Reload the page and try again.",
                    captcha_failed: 'The anti-bot check failed. Please try again.',
                    captcha_unavailable: "The anti-bot check is unavailable. Try again in a moment, or email me at hi@maxguerois.com.",
                    _: 'Signup failed. Try again in a moment.',
                },
            },
        };

        function bind(form) {
            // Later embeds add forms to the page as the browser parses it.
            if (form.hasAttribute('data-nl-bound')) return;
            form.setAttribute('data-nl-bound', '');

            var input = form.querySelector('input[name="email"]');
            var button = form.querySelector('button[type="submit"]');
            var err = form.querySelector('.nl-err');
            // Read the locale off the form's own action, not off the page: an EN
            // article footer and a FR one can both exist, and the component is
            // rendered per call site with its own locale.
            var lang = /lang=fr/.test(form.getAttribute('action') || '') ? 'fr' : 'en';
            var copy = COPY[lang];
            var label = button.textContent;

            // Mesure. Les evenements sont prefixes `newsletter_` et NON
            // `peptides_` : les memes noms melangeraient les deux entonnoirs
            // dans les tuiles existantes de la landing.
            //
            // `$pathname` est pose par PostHog sur chaque evenement, donc la
            // ventilation par article sort de ces evenements sans propriete
            // supplementaire.
            var srcInput = form.querySelector('input[name="source"]');
            var source = srcInput ? srcInput.value : 'inconnu';
            var started = false;
            function track(name, props) {
                if (window.mgTrack) window.mgTrack(name, props);
            }

            // Vu, pas seulement rempli. Deux formulaires par article, milieu et
            // pied : sans ce denominateur celui du pied parait mauvais alors
            // qu'il est seulement plus bas.
            if (typeof IntersectionObserver === 'function') {
                var vu = false;
                var io = new IntersectionObserver(function (entries) {
                    if (vu || !entries[0].isIntersecting) return;
                    vu = true;
                    io.disconnect();
                    track('newsletter_form_seen', { source: source });
                }, { threshold: 0.5 });
                io.observe(form);
            }

            // Une seule fois : sans ce verrou, chaque retour du focus dans le
            // champ compterait comme un nouveau debut de saisie, et l'etape
            // « commence » depasserait l'etape « vu ».
            input.addEventListener('focus', function () {
                if (started) return;
                started = true;
                track('newsletter_form_started', { source: source });
            });

            // Fetch Cloudflare's script at the first sign of intent rather than on
            // page load, so a reader who never touches the form never pays for it.
            // Three events, because each misses a real case the others catch:
            // `focusin` covers keyboard and screen-reader entry, `pointerdown` fires
            // before focus on a tap and buys those milliseconds back, and `change`
            // is what a browser autofill emits when it drops an address in without
            // either of the others. Idempotent, so firing all three costs nothing.
            //
            // A submit that beats the download does not fail: token() waits on the
            // same shared promise.
            function warmGate() {
                if (window.mgTurnstile) window.mgTurnstile.warm(form);
            }
            form.addEventListener('focusin', warmGate, { once: true });
            form.addEventListener('pointerdown', warmGate, { once: true });
            input.addEventListener('change', warmGate, { once: true });

            function showError(msg) {
                err.textContent = msg;
                err.hidden = false;
                input.setAttribute('aria-invalid', 'true');
            }
            function clearError() {
                err.hidden = true;
                input.removeAttribute('aria-invalid');
            }

            // Validate on blur, never on keystroke. Correcting someone while they are
            // still typing their address is the surest way to lose them.
            input.addEventListener('blur', function () {
                if (input.value && !input.checkValidity()) showError(copy.err.invalid_email);
                else clearError();
            });
            input.addEventListener('input', clearError);

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (form.hasAttribute('aria-busy')) return;
                if (!input.checkValidity()) {
                    showError(copy.err.invalid_email);
                    input.focus();
                    return;
                }
                form.setAttribute('aria-busy', 'true');
                clearError();
                track('newsletter_form_submitted', { source: source });
                button.disabled = true;
                button.textContent = copy.busy;

                // The token comes FIRST, and the request is not sent without one.
                // When the gate is off, `token()` resolves null and the payload is
                // byte-identical to what this form sent before Turnstile existed.
                var gate = window.mgTurnstile;
                var wait = gate && gate.active ? gate.token(form) : Promise.resolve(null);

                wait
                    .then(function (token) {
                        var payload = {};
                        new FormData(form).forEach(function (v, k) { payload[k] = v; });
                        // Cloudflare's own field name, which is also what the route
                        // reads. The widget runs with response-field:false, so this
                        // is the only copy of the token in the request.
                        if (token) payload['cf-turnstile-response'] = token;

                        return fetch(form.getAttribute('action'), {
                            method: 'POST',
                            headers: { 'content-type': 'application/json', accept: 'application/json' },
                            body: JSON.stringify(payload),
                        });
                    })
                    .then(function (r) {
                        return r.json().then(function (b) { return { ok: r.ok, body: b }; });
                    })
                    .then(function (res) {
                        if (!res.ok || !res.body.ok) throw new Error(res.body.error || '_');
                        // Replace the whole form, and move focus to the message. Without
                        // role + focus a screen reader never learns the signup worked.
                        var done = document.createElement('p');
                        done.className = 'nl-done';
                        done.setAttribute('role', 'status');
                        done.setAttribute('tabindex', '-1');
                        done.textContent = copy.done;
                        form.parentNode.replaceChild(done, form);
                        done.focus();
                        track('newsletter_subscribed', { source: source });
                        // Someone who just subscribed must never be shown the popup
                        // asking them to subscribe.
                        try { localStorage.setItem('mg_email_modal_v1', '1'); } catch (e3) {}
                        var dlg = document.querySelector('dialog.submodal');
                        if (dlg && dlg.open) dlg.close();
                    })
                    .catch(function (e2) {
                        // The field is NEVER cleared on error.
                        button.disabled = false;
                        button.textContent = label;
                        form.removeAttribute('aria-busy');
                        // A Turnstile token is single-use and dies after five
                        // minutes. Clearing it here is what makes the retry work:
                        // without it the second attempt re-sends a token the server
                        // has already seen or that has aged out, and the visitor
                        // reads the same failure however many times they press.
                        if (gate && gate.active) gate.reset(form);
                        track('newsletter_form_failed', {
                            source: source,
                            reason: window.mgReason ? window.mgReason(e2.message) : 'network'
                        });
                        var msg = copy.err[e2.message] || copy.err._;
                        // Le code numerique de Cloudflare, quand il y en a un. Sans
                        // lui, « indisponible » ne distingue pas un domaine non
                        // autorise (110200) d'une cle invalide (110100) ou d'une
                        // panne reseau, et chaque diagnostic coute un deploiement.
                        var tsCode = gate && gate.active && gate.lastError ? gate.lastError(form) : '';
                        if (tsCode) msg += ' [' + tsCode + ']';
                        showError(msg);
                    });
            });
        }

        var forms = document.querySelectorAll('form[data-nl-form]');
        for (var i = 0; i < forms.length; i++) bind(forms[i]);
    })();
</script>

<style>
    .nl-form { margin: 0; }

    .nl-label {
        display: block;
        font-size: 13px;
        color: var(--text-secondary);
        margin-bottom: var(--sp-2);
    }

    /* Off-screen rather than display:none. A hidden field is skipped by some bots;
       one that is merely positioned away is filled like any other. */
    .nl-hp {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .nl-row { display: flex; gap: var(--sp-2); flex-wrap: wrap; }

    .nl-row input[type="email"] {
        flex: 1 1 220px;
        min-width: 0;
        padding: 12px 14px;
        font-family: var(--font-body);
        font-size: 16px; /* below 16px, iOS Safari zooms the page on focus */
        /* `--text-primary` n'existe pas : les tokens sont --text,
             --text-secondary, --text-tertiary. La declaration etait donc
             invalide et la couleur retombait sur l'heritage, qui vaut #1a1a1a,
             soit la bonne valeur par accident. Le jour ou ce champ se retrouve
             dans un conteneur d'une autre couleur, l'email tape devient gris. */
          color: var(--text);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        /* DESIGN.md : le bouton et le champ sont en `--radius-full`. Le 4px
             n'etait ni dans l'echelle de rayons (8/10/12/100) ni dans la
             charte, et donnait deux formes de bouton differentes sur le meme
             site : carre ici, pilule sur /peptides. */
          border-radius: var(--radius-full);
    }

    .nl-row input[type="email"]:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .nl-row input[aria-invalid="true"] { border-color: #b3261e; }

    .nl-row button {
        /* 44px min touch target, per DESIGN.md. */
        min-height: 44px;
        padding: 12px 20px;
        font-family: var(--font-body);
        font-size: 15px;
        /* #1a1a1a, never var(--bg): in light mode that resolves to #faf9f7, and
           near-white on the amber accent measures 2.76:1, which fails WCAG AA.
           Dark ink on amber passes in both themes. Same call as /fr/peptides,
           recorded in DESIGN.md on 2026-08-26. */
        color: #1a1a1a;
        background: var(--accent);
        border: 0;
        /* DESIGN.md : le bouton et le champ sont en `--radius-full`. Le 4px
             n'etait ni dans l'echelle de rayons (8/10/12/100) ni dans la
             charte, et donnait deux formes de bouton differentes sur le meme
             site : carre ici, pilule sur /peptides. */
          border-radius: var(--radius-full);
        cursor: pointer;
        transition: opacity var(--duration-short) var(--ease-out);
    }

    .nl-row button:hover { opacity: 0.88; }
    .nl-row button[disabled] { opacity: 0.6; cursor: default; }

    .nl-err {
        margin: var(--sp-2) 0 0;
        font-size: 13px;
        color: #b3261e;
    }

    .nl-micro {
        margin: var(--sp-2) 0 0;
        font-size: 13px;
        color: var(--text-tertiary);
    }

    /* Rendered only when the gate is armed, and only for a visitor without
       JavaScript, for whom this form cannot work. Amber rather than the error red:
       nothing has failed yet. */
    .nl-nojs {
        margin: var(--sp-3) 0 0;
        padding: var(--sp-3);
        font-size: 13px;
        line-height: 1.5;
        color: var(--text-secondary);
        background: var(--accent-light);
        border: 1px solid var(--accent-mid);
        border-radius: 8px;
    }

    .nl-done {
        margin: 0;
        font-size: 15px;
        /* `--text-primary` n'existe pas : les tokens sont --text,
             --text-secondary, --text-tertiary. La declaration etait donc
             invalide et la couleur retombait sur l'heritage, qui vaut #1a1a1a,
             soit la bonne valeur par accident. Le jour ou ce champ se retrouve
             dans un conteneur d'une autre couleur, l'email tape devient gris. */
          color: var(--text);
    }

    .nl-done:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

    @media (prefers-reduced-motion: reduce) {
        .nl-row button { transition: none; }
    }
</style>

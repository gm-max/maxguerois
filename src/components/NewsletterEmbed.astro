---
/**
 * Beehiiv newsletter embed — used on homepage, experiments index, and article footers.
 */
---
<div class="newsletter-block">
    <div class="newsletter-header">
        <span class="newsletter-name">Follow the experiments</span>
    </div>
    <p class="newsletter-desc">When I publish a new experiment or project, it goes to your inbox first.</p>
    <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>
    <iframe
        src="https://subscribe-forms.beehiiv.com/2019016e-a00d-4333-886d-911b5e3eb2e6"
        class="beehiiv-embed"
        data-test-id="beehiiv-embed"
        frameborder="0"
        scrolling="no"
        style="width: 100%; max-width: 100%; height: 80px; margin: 0; border-radius: 0px !important; background-color: transparent;"
    ></iframe>
</div>

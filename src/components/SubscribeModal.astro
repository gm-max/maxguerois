---
/**
 * One-per-visitor email modal, adapted from the ouroslab.co subscribe popup.
 *
 * Both of this file's odd shapes existed because it wrapped beehiiv's CROSS-ORIGIN
 * iframe, and both are gone now that the form is same-origin:
 *
 * 1. It could not detect a subscribe, because a page cannot observe a submission
 *    inside a cross-origin frame and beehiiv documents no postMessage. So it never
 *    tried. NewsletterEmbed now closes this dialog itself on success.
 *
 * 2. The once-per-visitor flag had to be written when the modal was SHOWN, since
 *    "subscribed" was unobservable. It still is, which is deliberate: the modal
 *    covers the page, so a visitor deals with it either way, and writing on show
 *    means nobody is asked twice. Erring toward showing it less.
 *
 * Preview it any time with ?popup=1, which ignores the flag.
 */
import type { Locale } from '../i18n/utils';
import { t } from '../i18n/utils';
import NewsletterEmbed from './NewsletterEmbed.astro';

interface Props {
    locale?: Locale;
    /**
     * Milliseconds before it appears. 8s (was 15s, shortened 2026-08-25): long
     * enough not to land on the first paint, short enough to reach someone who
     * skims and leaves. The shorter it gets, the more it can race beehiiv's
     * height handshake, which the guard in NewsletterEmbed absorbs.
     */
    delayMs?: number;
}

const { locale = 'en', delayMs = 8000 } = Astro.props;
---

<dialog class="submodal" data-submodal data-delay={delayMs} aria-labelledby="submodal-title" aria-describedby="submodal-desc">
    <div class="submodal__card">
        <button
            type="button"
            class="submodal__close"
            data-submodal-dismiss
            aria-label={t(locale, 'modal.close')}
        >&times;</button>

        <h2 class="submodal__title" id="submodal-title">{t(locale, 'modal.title')}</h2>
        <p class="submodal__desc" id="submodal-desc">{t(locale, 'modal.desc')}</p>

        <NewsletterEmbed locale={locale} minimal source="modal" />

        <p class="submodal__note">{t(locale, 'modal.note')}</p>
    </div>
</dialog>

<script is:inline>
(function () {
    var root = document.querySelector('[data-submodal]');
    if (!root) return;

    var STORE_KEY = 'mg_email_modal_v1';
    var preview = new URLSearchParams(window.location.search).get('popup') === '1';
    var timer = null;

    function alreadySeen() {
        try { return localStorage.getItem(STORE_KEY) === '1'; } catch (e) { return false; }
    }

    // Nothing to preload any more. This used to start the beehiiv iframe fetch at
    // page load, gated on the visitor still being eligible, because a dismissed modal
    // would otherwise fetch a third-party frame on every page view forever. The form
    // is now part of the document: no request, no deferral, no gate.

    function track(name) {
        try { if (typeof window.gtag === 'function') window.gtag('event', name); } catch (e) {}
    }

    function remember() {
        try { localStorage.setItem(STORE_KEY, '1'); } catch (e) {
            // Private mode or storage blocked. The modal may reappear next visit,
            // which is the acceptable failure here.
        }
    }

    function open() {
        if (root.open) return;
        // showModal, not the `open` attribute. It was adopted because a hand-rolled
        // dialog could not survive a cross-origin iframe: Escape died the moment the
        // visitor clicked the email field, since a keydown listener on the parent
        // document never sees keys pressed inside the frame. The frame is gone, but
        // showModal stays, because what it gives is worth having on its own: UA-level
        // Escape, an inert background so Tab cannot walk out of the dialog, and dialog
        // semantics from the element instead of an aria-modal claim over a live page.
        try { root.showModal(); } catch (e) { root.setAttribute('open', ''); }
        track('email_modal_shown');
    }

    function close() {
        if (root.open) root.close();
    }

    // Fires for both Escape (UA `cancel`) and any close() call, so bookkeeping
    // lives in one place rather than on each dismissal path.
    root.addEventListener('close', function () {
        document.body.style.overflow = '';
        track('email_modal_dismissed');
    });

    // Click outside the card. With showModal the backdrop is the dialog itself,
    // so a click landing on the dialog element means outside the card.
    root.addEventListener('click', function (e) { if (e.target === root) close(); });
    root.querySelectorAll('[data-submodal-dismiss]').forEach(function (el) {
        el.addEventListener('click', close);
    });

    function arm() {
        document.body.style.overflow = 'hidden';
        if (!preview) remember();
        open();
    }

    if (preview) { arm(); return; }
    if (alreadySeen()) return;

    var delay = parseInt(root.getAttribute('data-delay'), 10);
    if (!(delay >= 0)) delay = 8000;
    timer = window.setTimeout(arm, delay);

    // Do not fire at a page nobody is looking at.
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden' && timer) {
            window.clearTimeout(timer);
            timer = null;
        }
    });
})();
</script>

<style>
    /* A closed <dialog> is display:none per the UA stylesheet. This rule overrides
       that to keep the subtree laid out.

       Its original reason is GONE: a subtree with no layout made beehiiv measure its
       iframe at 0, leaving the form blank for seconds after opening (546b4e1). There
       is no iframe and no measuring any more.

       It is kept because the entrance animation below is attached in the open state
       and this rule is part of how that was made to work, and because removing it
       changes rendering in a way only a real eye can grade. Worth revisiting, but not
       inside a change whose job is to delete beehiiv. */
    .submodal:not([open]) {
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
    }

    .submodal {
        /* Reset the UA dialog box: it centres via auto margins and carries its own
           border, padding and max-width, none of which we want. */
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        inset: 0;
        max-width: 100%;
        max-height: 100%;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: var(--sp-4);
        border: 0;
        background: transparent;
        overflow: visible;
    }

    .submodal::backdrop {
        background: rgba(15, 14, 12, 0.45);
    }



    .submodal__card {
        position: relative;
        width: 100%;
        max-width: 420px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: var(--sp-8) var(--sp-6) var(--sp-6);
        box-shadow: 0 24px 64px rgba(15, 14, 12, 0.28);
    }

    .submodal__close {
        position: absolute;
        top: var(--sp-1);
        right: var(--sp-1);
        border: 0;
        background: transparent;
        cursor: pointer;
        font-size: 26px;
        line-height: 1;
        color: var(--text-tertiary);
        /* 44x44 is the touch-target minimum in DESIGN.md. Grow the HIT AREA, not
           the glyph: a bigger cross would fight the card's restraint, and the
           button measured 31x34 before this, which is a real miss with a thumb
           at the exact moment the modal is interrupting someone. */
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 0;
    }
    .submodal__close:hover { color: var(--text); }

    .submodal__title {
        margin: 0 0 var(--sp-2);
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 500;
        line-height: 1.2;
        color: var(--text);
    }

    .submodal__desc {
        margin: 0 0 var(--sp-4);
        font-size: 0.94rem;
        line-height: 1.5;
        color: var(--text-secondary);
    }

    .submodal__note {
        margin: var(--sp-3) 0 0;
        font-size: 0.78rem;
        color: var(--text-tertiary);
    }

    /* The embed carries its own block spacing for in-page use; inside the card
       that would push the form off the bottom edge. */
    .submodal__card :global(.newsletter-block) {
        margin: 0;
        padding: 0;
        border: 0;
        background: transparent;
    }

    /* Cap the CARD against the viewport and let it scroll. This is all that survives
       of a much larger block: beehiiv's embed.js wrote a transient inline
       `height: 2000px` on its iframe while measuring, which stretched the card to
       2220px and threw it off screen, and the fix went through pinning the height
       (which then clipped the taller post-subscribe state) before landing on a cap.
       A same-origin form has no measuring handshake and no transient, so only the
       viewport cap is still worth keeping, as a seatbelt on a small screen. */
    .submodal__card {
        max-height: calc(100vh - var(--sp-4) * 2);
        overflow-y: auto;
    }

    /* Entrance animation is attached ONLY in the open state.
       The closed modal is visibility:hidden but still rendered (see the [hidden]
       rule above), and a CSS animation on a non-rendered subtree is created at
       page load and then never advances: it sits at 0% forever. Since 0% of
       submodal-rise is opacity:0, declaring the animation on the base rule left
       the card INVISIBLE when it opened, with the backdrop dimming the page
       behind nothing. Shipped that way in c98e12e; caught on production.
       Scoping to :not([hidden]) means the animation is created at the moment the
       attribute is removed, so it actually plays. */
    .submodal[open]::backdrop {
        animation: submodal-fade var(--duration-short) var(--ease-out);
    }
    .submodal[open] .submodal__card {
        animation: submodal-rise var(--duration-base) var(--ease-out);
    }

    @keyframes submodal-fade {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @keyframes submodal-rise {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .submodal[open]::backdrop,
        .submodal[open] .submodal__card { animation: none; }
    }
</style>

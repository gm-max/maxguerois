---
/**
 * One-per-visitor email modal, adapted from the ouroslab.co subscribe popup.
 *
 * Two deliberate differences from the Ouros original, both forced by beehiiv:
 *
 * 1. The Ouros popup closes itself when the visitor subscribes, because its form
 *    posts same-origin and the component gets a callback. Ours wraps beehiiv's
 *    CROSS-ORIGIN iframe, so the page cannot see a submission at all. beehiiv
 *    publishes no documented postMessage on submit, and its embed.js sits behind
 *    Cloudflare so the behaviour could not be verified either. Rather than code
 *    against a guess, this modal never tries to detect a subscribe.
 *
 * 2. Because of (1), the once-per-visitor flag is written when the modal is
 *    SHOWN, not when it is dismissed. The modal covers the page, so a visitor has
 *    to deal with it either way, and writing on show means someone who subscribes
 *    and then closes the tab is never asked twice. Erring toward showing it less.
 *
 * Preview it any time with ?popup=1, which ignores the flag.
 */
import type { Locale } from '../i18n/utils';
import { t } from '../i18n/utils';
import NewsletterEmbed from './NewsletterEmbed.astro';

interface Props {
    locale?: Locale;
    /** Milliseconds before it appears. Long enough not to interrupt the first read. */
    delayMs?: number;
}

const { locale = 'en', delayMs = 15000 } = Astro.props;
---

<dialog class="submodal" data-submodal data-delay={delayMs} aria-labelledby="submodal-title" aria-describedby="submodal-desc">
    <div class="submodal__card">
        <button
            type="button"
            class="submodal__close"
            data-submodal-dismiss
            aria-label={t(locale, 'modal.close')}
        >&times;</button>

        <h2 class="submodal__title" id="submodal-title">{t(locale, 'modal.title')}</h2>
        <p class="submodal__desc" id="submodal-desc">{t(locale, 'modal.desc')}</p>

        <NewsletterEmbed locale={locale} minimal deferSrc />

        <p class="submodal__note">{t(locale, 'modal.note')}</p>
    </div>
</dialog>

<script is:inline>
(function () {
    var root = document.querySelector('[data-submodal]');
    if (!root) return;

    var STORE_KEY = 'mg_email_modal_v1';
    var preview = new URLSearchParams(window.location.search).get('popup') === '1';
    var timer = null;

    function alreadySeen() {
        try { return localStorage.getItem(STORE_KEY) === '1'; } catch (e) { return false; }
    }

    // Start the embed load at page load, and only when this visitor can still be
    // shown the modal. Not before: a visitor who dismissed it once would fetch a
    // third-party iframe on every page view forever. Not later: deferring to the
    // open event is what made the form arrive ~4s after the card.
    if (preview || !alreadySeen()) {
        var frame = root.querySelector('iframe[data-src]');
        if (frame && !frame.src) frame.src = frame.getAttribute('data-src');
    }

    function track(name) {
        try { if (typeof window.gtag === 'function') window.gtag('event', name); } catch (e) {}
    }

    function remember() {
        try { localStorage.setItem(STORE_KEY, '1'); } catch (e) {
            // Private mode or storage blocked. The modal may reappear next visit,
            // which is the acceptable failure here.
        }
    }

    function open() {
        if (root.open) return;
        // showModal, not the `open` attribute. It is what buys the three things a
        // hand-rolled dialog cannot have over a CROSS-ORIGIN iframe:
        //   - Escape works even when focus is inside the beehiiv frame. A keydown
        //     listener on the parent document never sees those keys, so the old
        //     handler died the moment the visitor clicked the email field, which
        //     is the one thing the modal exists to make them do.
        //   - the page behind becomes inert, so forward-Tab past beehiiv's last
        //     control can no longer land in the page instead of the dialog.
        //   - dialog semantics come from the element, so no aria-modal claim on a
        //     background that is still live.
        try { root.showModal(); } catch (e) { root.setAttribute('open', ''); }
        track('email_modal_shown');
    }

    function close() {
        if (root.open) root.close();
    }

    // Fires for both Escape (UA `cancel`) and any close() call, so bookkeeping
    // lives in one place rather than on each dismissal path.
    root.addEventListener('close', function () {
        document.body.style.overflow = '';
        track('email_modal_dismissed');
    });

    // Click outside the card. With showModal the backdrop is the dialog itself,
    // so a click landing on the dialog element means outside the card.
    root.addEventListener('click', function (e) { if (e.target === root) close(); });
    root.querySelectorAll('[data-submodal-dismiss]').forEach(function (el) {
        el.addEventListener('click', close);
    });

    function arm() {
        document.body.style.overflow = 'hidden';
        if (!preview) remember();
        open();
    }

    if (preview) { arm(); return; }
    if (alreadySeen()) return;

    var delay = parseInt(root.getAttribute('data-delay'), 10);
    if (!(delay >= 0)) delay = 15000;
    timer = window.setTimeout(arm, delay);

    // Do not fire at a page nobody is looking at.
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden' && timer) {
            window.clearTimeout(timer);
            timer = null;
        }
    });
})();
</script>

<style>
    /* A closed <dialog> is display:none per the UA stylesheet, which would put us
       straight back into the bug 546b4e1 fixed: a subtree with no layout means
       beehiiv measures the iframe at 0 and the form is blank for seconds after
       opening. Keep it laid out and merely invisible instead. showModal() still
       promotes it to the top layer normally. */
    .submodal:not([open]) {
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
    }

    .submodal {
        /* Reset the UA dialog box: it centres via auto margins and carries its own
           border, padding and max-width, none of which we want. */
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        inset: 0;
        max-width: 100%;
        max-height: 100%;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: var(--sp-4);
        border: 0;
        background: transparent;
        overflow: visible;
    }

    .submodal::backdrop {
        background: rgba(15, 14, 12, 0.45);
    }



    .submodal__card {
        position: relative;
        width: 100%;
        max-width: 420px;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: var(--sp-8) var(--sp-6) var(--sp-6);
        box-shadow: 0 24px 64px rgba(15, 14, 12, 0.28);
    }

    .submodal__close {
        position: absolute;
        top: var(--sp-1);
        right: var(--sp-1);
        border: 0;
        background: transparent;
        cursor: pointer;
        font-size: 26px;
        line-height: 1;
        color: var(--text-tertiary);
        /* 44x44 is the touch-target minimum in DESIGN.md. Grow the HIT AREA, not
           the glyph: a bigger cross would fight the card's restraint, and the
           button measured 31x34 before this, which is a real miss with a thumb
           at the exact moment the modal is interrupting someone. */
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        padding: 0;
    }
    .submodal__close:hover { color: var(--text); }

    .submodal__title {
        margin: 0 0 var(--sp-2);
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 500;
        line-height: 1.2;
        color: var(--text);
    }

    .submodal__desc {
        margin: 0 0 var(--sp-4);
        font-size: 0.94rem;
        line-height: 1.5;
        color: var(--text-secondary);
    }

    .submodal__note {
        margin: var(--sp-3) 0 0;
        font-size: 0.78rem;
        color: var(--text-tertiary);
    }

    /* The embed carries its own block spacing for in-page use; inside the card
       that would push the iframe off the bottom edge. */
    .submodal__card :global(.newsletter-block) {
        margin: 0;
        padding: 0;
        border: 0;
        background: transparent;
    }

    /* Bound the embed instead of pinning it.
       beehiiv's embed.js briefly sets an inline `height: 2000px` on its iframe
       while it measures, then settles to the real height (47px for this form).
       Left alone, that transient stretches the card to 2220px and throws it off
       screen. It only bites when the modal opens during the window, which in
       practice means ?popup=1, since the 15s delay outlasts the handshake.

       The first fix here pinned `height: 80px !important`. That killed the
       transient but also capped the iframe forever, so a taller state (the
       confirmation beehiiv swaps in after a successful subscribe) would have
       been clipped with no way to see it. Trading a preview-only glitch for a
       broken success screen is the wrong way round.

       So: cap rather than fix. max-height bounds the transient, lets the form
       size itself, and still allows a taller post-subscribe state. The card caps
       itself against the viewport and scrolls as the last resort, so no height
       beehiiv ever chooses can push the modal off screen.
       Verified live at 47px, 2000px and 420px: all three stay fully on screen. */
    .submodal__card {
        max-height: calc(100vh - var(--sp-4) * 2);
        overflow-y: auto;
    }
    /* The iframe's own bounds live in NewsletterEmbed.astro, so both placements
       get the same seatbelt. What stays here is modal-specific: cap the CARD
       against the viewport and let it scroll, so no height beehiiv ever picks
       can push the modal off screen. */

    /* Entrance animation is attached ONLY in the open state.
       The closed modal is visibility:hidden but still rendered (see the [hidden]
       rule above), and a CSS animation on a non-rendered subtree is created at
       page load and then never advances: it sits at 0% forever. Since 0% of
       submodal-rise is opacity:0, declaring the animation on the base rule left
       the card INVISIBLE when it opened, with the backdrop dimming the page
       behind nothing. Shipped that way in c98e12e; caught on production.
       Scoping to :not([hidden]) means the animation is created at the moment the
       attribute is removed, so it actually plays. */
    .submodal[open]::backdrop {
        animation: submodal-fade var(--duration-short) var(--ease-out);
    }
    .submodal[open] .submodal__card {
        animation: submodal-rise var(--duration-base) var(--ease-out);
    }

    @keyframes submodal-fade {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @keyframes submodal-rise {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
        .submodal[open]::backdrop,
        .submodal[open] .submodal__card { animation: none; }
    }
</style>

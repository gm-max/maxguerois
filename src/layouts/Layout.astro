---
// Layout.astro — base layout for all pages
// maxguerois.com
import SubscribeModal from '../components/SubscribeModal.astro';
import type { Locale } from '../i18n/utils';
import { getLocalizedPath, getAbsoluteUrl, t } from '../i18n/utils';

interface Props {
    title: string;
    description?: string;
    ogType?: string;
    ogUrl?: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    ogImageAlt?: string;
    ogImageWidth?: number;
    ogImageHeight?: number;
    twitterCard?: string;
    structuredData?: object | object[];
    extraStyles?: string[];
    locale?: Locale;
    /** Set false to suppress the one-per-visitor email modal on this page. */
    emailModal?: boolean;
    hideFooter?: boolean;
    noindex?: boolean;
    /**
     * Page hors du miroir FR/EN.
     *
     * Le site est un miroir : chaque page anglaise a sa jumelle sous /fr. Deux
     * mecanismes en dependent, et tous deux se trompent sur une page qui n'a pas
     * de jumelle : les liens hreflang annoncent une alternative qui n'existe pas,
     * et le script de redirection de langue renvoie un visiteur au navigateur
     * francais de /page vers /fr/page. Sur une landing francaise servie a /page,
     * ce dernier provoque un aller-retour parasite au premier affichage, pour
     * exactement le public vise.
     */
    standalone?: boolean;
}

const {
    title,
    description,
    ogType = 'website',
    ogUrl,
    ogTitle,
    ogDescription,
    ogImage = 'https://maxguerois.com/og.jpg',
    ogImageAlt,
    ogImageWidth = 1200,
    ogImageHeight = 630,
    twitterCard = 'summary_large_image',
    structuredData,
    extraStyles = [],
    locale = 'en',
    hideFooter = false,
    noindex = false,
    standalone = false,
    emailModal = true,
} = Astro.props;

// Build hreflang URLs from current path
const currentPath = Astro.url.pathname;
const englishPath = getLocalizedPath(currentPath, 'en');
const frenchPath = getLocalizedPath(currentPath, 'fr');
// Chemin canonique force pour GA4 sur les pages hors miroir, voir gtag plus bas.
// `null` partout ailleurs : GA garde alors son comportement par defaut.
const gaPagePath = standalone && ogUrl ? new URL(ogUrl).pathname : null;
const enUrl = getAbsoluteUrl(englishPath, 'en');
const frUrl = getAbsoluteUrl(frenchPath, 'fr');

// The modal shows everywhere by default, including the newsletter pages (Max's
// call, 2026-08-25). Pages opt out individually with `emailModal={false}`, which
// is how /404 excludes itself: a path list could not do it there, since a 404's
// runtime pathname is whatever missing URL the visitor typed, not '/404'.
const showEmailModal = emailModal;
---
<!DOCTYPE html>
<html lang={locale} data-standalone={standalone ? '' : undefined} data-analytics-path={gaPagePath ?? undefined}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    {description && <meta name="description" content={description}>}
    {noindex && <meta name="robots" content="noindex, follow">}

    <!-- Hreflang — SEO alternate language links. Supprimes sur une page
         standalone : annoncer une alternative qui n'existe pas est un signal
         faux, pas un signal absent. -->
    {!standalone && (
    <>
    <link rel="alternate" hreflang="en" href={enUrl}>
    <link rel="alternate" hreflang="fr" href={frUrl}>
    <link rel="alternate" hreflang="x-default" href={enUrl}>
    </>
    )}

    <!-- Dark mode — runs before first paint to avoid flash -->
    <script is:inline>
        (function() {
            try {
                var stored = localStorage.getItem('theme');
                var theme = stored || 'light';
                document.documentElement.setAttribute('data-theme', theme);
            } catch(e) {
                // localStorage unavailable (private browsing) — default to light
            }
        })();
    </script>

    <!-- Language auto-detection — redirect French browsers to /fr/ on first visit -->
    <script is:inline>
        (function() {
            try {
                // REQ-10: never redirect crawlers, so canonical (en) URLs stay
                // indexable. hreflang is the real language signal for bots.
                var ua = navigator.userAgent || '';
                if (/bot|crawl|spider|slurp|Googlebot|bingbot|GPTBot|ClaudeBot|PerplexityBot|Google-Extended|facebookexternalhit|embedly/i.test(ua)) return;
                // Only run on English pages (no /fr/ prefix)
                if (window.location.pathname.startsWith('/fr')) return;
                // Pages hors miroir : pas de jumelle a rejoindre.
                if (document.documentElement.hasAttribute('data-standalone')) return;
                // Respect stored language preference
                var pref = localStorage.getItem('lang-preference');
                if (pref) return;
                // Check browser language
                var lang = navigator.language || navigator.userLanguage || '';
                if (lang.substring(0, 2) === 'fr') {
                    // Build French equivalent of current path
                    var frPath = '/fr' + (window.location.pathname === '/' ? '' : window.location.pathname);
                    localStorage.setItem('lang-preference', 'fr');
                    window.location.replace(frPath);
                }
            } catch(e) {}
        })();
    </script>

    <!-- Canonical -->
    {ogUrl && <link rel="canonical" href={ogUrl}>}

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType}>
    {ogUrl && <meta property="og:url" content={ogUrl}>}
    <meta property="og:site_name" content="Max Guerois">
    <meta property="og:title" content={ogTitle || title}>
    {ogDescription && <meta property="og:description" content={ogDescription}>}
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content={String(ogImageWidth)}>
    <meta property="og:image:height" content={String(ogImageHeight)}>
    <meta property="og:image:alt" content={ogImageAlt || ogTitle || title}>
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'}>
    {locale === 'en' && <meta property="og:locale:alternate" content="fr_FR">}
    {locale === 'fr' && <meta property="og:locale:alternate" content="en_US">}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content={twitterCard}>
    <meta name="twitter:site" content="@maxguerois">
    <meta name="twitter:title" content={ogTitle || title}>
    {ogDescription && <meta name="twitter:description" content={ogDescription}>}
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={ogImageAlt || ogTitle || title}>

    {structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-DR1W1B2VV5"></script>
    <script is:inline define:vars={{ gaPagePath }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        // Sur une page hors miroir servie a deux URL, GA4 comptait /peptides et
        // /fr/peptides comme deux pages distinctes, alors que le canonical, le
        // sitemap et le contenu n'en decrivent qu'une. Le taux de conversion du
        // funnel se serait retrouve coupe en deux.
        gtag('config', 'G-DR1W1B2VV5', gaPagePath ? { page_path: gaPagePath } : {});
    </script>

    <!-- PostHog -->
    <script is:inline>
        // File d'attente, posee AVANT tout le reste.
        //
        // posthog-js est charge par un module differe : il n'existe pas encore
        // quand le script en ligne de /peptides s'execute. Sans ce relais, tout
        // evenement des premieres centaines de millisecondes serait perdu, soit
        // exactement le debut de session qu'on cherche a mesurer.
        //
        // Plafonnee : si la cle est vide ou l'hote inconnu, personne ne vide
        // jamais la file, et une page laissee ouverte la ferait grossir sans fin.
        window.__mgq = [];
        window.mgTrack = function (name, props) {
            if (window.__mgq.length < 50) window.__mgq.push([name, props]);
        };

        // Liste blanche des motifs d'echec, partagee par les DEUX formulaires du
        // site (la landing peptides et NewsletterEmbed). Elle vit ici parce que
        // les deux scripts sont `is:inline` et ne peuvent rien importer : la
        // seule alternative etait de la copier, et la premiere copie a diverger
        // aurait fausse un graphique sans que rien ne le signale.
        //
        // Un echec de fetch porte un message ecrit par le NAVIGATEUR, different
        // d'un moteur a l'autre et traduit selon la langue de l'utilisateur.
        // Sans borne, la propriete accumule une valeur par variante.
        var MG_CODES = ['invalid_email', 'rate_limited', 'store_failed', 'bad_request'];
        window.mgReason = function (message) {
            return MG_CODES.indexOf(message) === -1 ? 'network' : message;
        };
    </script>
    <script>
        import { initAnalytics } from '../lib/analytics';
        initAnalytics().catch(function () {
            // Bloqueur de pub : eu.i.posthog.com est dans les listes par defaut
            // d'uBlock et de Brave. L'echec est le cas NORMAL pour une part
            // reelle des visiteurs, pas une anomalie a signaler. Sans ce catch,
            // chaque page du site produisait une promesse rejetee non geree.
            // La file reste le bouchon et se remplit jusqu'a 50, sans effet.
        });
    </script>

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="/styles/nav.css">
    <link rel="stylesheet" href="/styles/global.css">
    {extraStyles.map(href => <link rel="stylesheet" href={href} />)}
</head>
<body>
    <slot name="nav">
        <!-- Default navbar — pages can override with slot="nav" -->
        <nav class="navbar">
            <div class="navbar-inner">
                <a href={locale === 'fr' ? '/fr' : '/'} class="navbar-name">Max Guerois</a>
                <a
                    href={locale === 'fr' ? '/fr/newsletter' : '/newsletter'}
                    class:list={["navbar-link", { active: currentPath.replace(/\/$/, '').endsWith('newsletter') }]}
                >{t(locale, 'nav.newsletter')}</a>
            </div>
        </nav>
    </slot>
    <slot />
    <!-- Site footer — socials + newsletter + language + theme.
         Pages with an in-hero footer pass hideFooter to avoid doubling up. -->
    {!hideFooter && (
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-social">
                <a href="https://linkedin.com/in/maxguerois" target="_blank" aria-label="LinkedIn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                </a>
                <a href="https://x.com/maxguerois" target="_blank" aria-label="X">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a href="https://instagram.com/maxguerois" target="_blank" aria-label="Instagram">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                </a>
            </div>
            <div class="footer-links">
                <a
                    href={locale === 'fr' ? '/fr/newsletter' : '/newsletter'}
                    class:list={["footer-link", { active: currentPath.replace(/\/$/, '').endsWith('newsletter') }]}
                >{t(locale, 'nav.newsletter')}</a>
                {/* Pas de bascule de langue sur une page hors miroir : elle n'a
                    pas de jumelle. Sur /peptides le lien « EN » pointait sur
                    /peptides, c'est-a-dire sur lui-meme, tout en promettant
                    « Switch to English » et en memorisant lang-preference=en. */}
                {!standalone && (
                <>
                <span class="footer-sep" aria-hidden="true"></span>
                <a
                    href={locale === 'fr' ? getLocalizedPath(currentPath, 'en') : getLocalizedPath(currentPath, 'fr')}
                    class="footer-lang"
                    aria-label={t(locale, 'nav.langSwitchLabel')}
                    data-lang-switch
                >{t(locale, 'nav.langSwitch')}</a>
                </>
                )}
                <span class="footer-sep" aria-hidden="true"></span>
                <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">
                    <span id="toggle-icon">☾</span>
                </button>
            </div>
            <div class="footer-copy">© {new Date().getFullYear()} Max Guerois</div>
        </div>
    </footer>
    )}
    <script is:inline>
        (function() {
            var toggle = document.getElementById('theme-toggle');
            var icon = document.getElementById('toggle-icon');
            if (toggle && icon) {
                var updateToggle = function() {
                    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                    icon.textContent = isDark ? '☀' : '☾';
                };
                updateToggle();
                toggle.addEventListener('click', function() {
                    var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                    var newTheme = isDark ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', newTheme);
                    try { localStorage.setItem('theme', newTheme); } catch(e) {}
                    updateToggle();
                });
            }

            // Language switcher — save preference on click
            var langLinks = document.querySelectorAll('[data-lang-switch]');
            langLinks.forEach(function(link) {
                link.addEventListener('click', function() {
                    var target = link.getAttribute('href');
                    var lang = target && target.startsWith('/fr') ? 'fr' : 'en';
                    try { localStorage.setItem('lang-preference', lang); } catch(e) {}
                });
            });
        })();
    </script>
    {showEmailModal && <SubscribeModal locale={locale} />}
</body>
</html>

---
// ArticleLayout.astro — layout for all article/experiment pages
// Extends Layout.astro — no head duplication
// maxguerois.com
import Layout from './Layout.astro';
import type { Locale } from '../i18n/utils';

interface Props {
    title: string;
    description?: string;
    ogUrl?: string;
    ogImage?: string;
    articleStyles?: string;
    locale?: Locale;
}

const { title, description, ogUrl, ogImage, articleStyles, locale = 'en' } = Astro.props;
---
<Layout
    title={title}
    description={description}
    ogType="article"
    ogUrl={ogUrl}
    ogTitle={title}
    ogDescription={description}
    ogImage={ogImage}
    extraStyles={["/styles/article.css"]}
    locale={locale}
>
    {articleStyles && <style set:html={articleStyles} />}
    <slot />
</Layout>

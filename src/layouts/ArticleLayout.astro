---
// ArticleLayout.astro — layout for all article/experiment pages
// Extends Layout.astro — no head duplication
// maxguerois.com
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/utils';

interface Props {
    title: string;
    description?: string;
    ogUrl?: string;
    ogImage?: string;
    articleStyles?: string;
    locale?: Locale;
    // REQ-1 fallbacks for articles not in the content collection (e.g. lucis-chapter)
    datePublished?: string;
    headline?: string;
    // REQ-2: optional HowTo / FAQPage JSON-LD (must mirror on-page content 1:1)
    structuredExtra?: object | object[];
}

const {
    title, description, ogUrl, ogImage, articleStyles, locale = 'en',
    datePublished, headline, structuredExtra,
} = Astro.props;

// REQ-1 — Article JSON-LD, sourced from the content collection where possible.
// Slug is derived from the canonical URL so the 12 collection articles need no
// per-page changes; lucis-chapter (not in the collection) passes its own props.
const slug = ogUrl ? ogUrl.replace(/\/$/, '').split('/').pop() : undefined;
const experiments = await getCollection('experiments');
const entry = slug
    ? experiments.find((e) => e.data.slug === slug && (e.data.locale || 'en') === locale)
    : undefined;

const pubDate = datePublished || entry?.data.date;
const head = headline || entry?.data.title || title;
const person = { '@type': 'Person', name: 'Max Guerois', url: 'https://maxguerois.com' };

// Keep authored JSON-LD em-dash-free (site copy rule). Some existing titles/
// descriptions use em-dashes; swap them for a colon in the structured data only.
const noEmDash = (s?: string) => (s ? s.replace(/\s*—\s*/g, ': ') : s);

const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: noEmDash(head),
    ...(description ? { description: noEmDash(description) } : {}),
    ...(ogImage ? { image: ogImage } : {}),
    ...(pubDate ? { datePublished: pubDate, dateModified: pubDate } : {}),
    inLanguage: locale === 'fr' ? 'fr-FR' : 'en-US',
    ...(ogUrl ? { mainEntityOfPage: { '@type': 'WebPage', '@id': ogUrl }, url: ogUrl } : {}),
    author: person,
    publisher: person,
};

// REQ-9 — BreadcrumbList: Home > Newsletter > Article.
const breadcrumbSchema = ogUrl
    ? {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
              { '@type': 'ListItem', position: 1, name: locale === 'fr' ? 'Accueil' : 'Home', item: locale === 'fr' ? 'https://maxguerois.com/fr' : 'https://maxguerois.com/' },
              { '@type': 'ListItem', position: 2, name: 'Newsletter', item: locale === 'fr' ? 'https://maxguerois.com/fr/newsletter' : 'https://maxguerois.com/newsletter' },
              { '@type': 'ListItem', position: 3, name: noEmDash(head), item: ogUrl },
          ],
      }
    : null;

const extras = structuredExtra
    ? (Array.isArray(structuredExtra) ? structuredExtra : [structuredExtra])
    : [];
const structuredData = [articleSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...extras];
---
<Layout
    title={title}
    description={description}
    ogType="article"
    ogUrl={ogUrl}
    ogTitle={title}
    ogDescription={description}
    ogImage={ogImage}
    extraStyles={["/styles/article.css"]}
    locale={locale}
    structuredData={structuredData}
>
    {articleStyles && <style set:html={articleStyles} />}
    <slot />

    <!-- Sticky subscribe bar — always-visible signup path while reading -->
    <div class="subscribe-bar" data-subscribe-bar aria-hidden="true">
        <span class="subscribe-bar-text">{locale === 'fr' ? 'Reçois ma prochaine expérience par email' : 'Get my next experiment in your inbox'}</span>
        <button class="subscribe-bar-btn" type="button" data-subscribe-scroll>{locale === 'fr' ? "S'abonner" : 'Subscribe'}</button>
    </div>

    <style>
        .subscribe-bar {
            position: fixed;
            left: 0; right: 0; bottom: 0;
            z-index: 90;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            padding: 12px 20px;
            background: var(--navbar-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-top: 1px solid var(--border);
            transform: translateY(120%);
            transition: transform 0.3s ease;
        }
        .subscribe-bar.visible { transform: translateY(0); }
        .subscribe-bar-text {
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 500;
            color: var(--text);
        }
        .subscribe-bar-btn {
            font-family: var(--font-body);
            font-size: 14px;
            font-weight: 600;
            color: var(--bg);
            background: var(--text);
            border: none;
            border-radius: var(--radius-full);
            padding: 9px 22px;
            cursor: pointer;
            white-space: nowrap;
            transition: opacity 0.15s ease;
        }
        .subscribe-bar-btn:hover { opacity: 0.85; }
        @media (max-width: 600px) {
            .subscribe-bar { gap: 10px; padding: 10px 14px; }
            .subscribe-bar-text { font-size: 13px; line-height: 1.25; }
            .subscribe-bar-btn { padding: 9px 16px; font-size: 13px; }
        }
    </style>

    <script is:inline>
        (function () {
            var bar = document.querySelector('[data-subscribe-bar]');
            if (!bar) return;
            var btn = bar.querySelector('[data-subscribe-scroll]');
            var forms = document.querySelectorAll('.newsletter-block');
            if (!forms.length) return;
            function formInView() {
                for (var i = 0; i < forms.length; i++) {
                    var r = forms[i].getBoundingClientRect();
                    if (r.top < window.innerHeight && r.bottom > 0) return true;
                }
                return false;
            }
            function update() {
                var show = window.scrollY > 500 && !formInView();
                bar.classList.toggle('visible', show);
                bar.setAttribute('aria-hidden', show ? 'false' : 'true');
            }
            btn.addEventListener('click', function () {
                forms[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
            window.addEventListener('scroll', update, { passive: true });
            window.addEventListener('resize', update, { passive: true });
            update();
        })();
    </script>
</Layout>
